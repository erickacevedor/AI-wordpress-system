ng","elType":"widget"},{"id":"750c716","settings":{"editor":"<p>In Sumner, Robertson, and Davidson Counties, our local water is notoriously \"hard,\" leading to scale buildup that destroys water heaters and faucets. Furthermore, shifting city pressure often exceeds 80 PSI, putting immense stress on your home's plumbing joints. We specialize in localized solutions that neutralize these regional threats.<\/p>","align":"center","_element_width":"initial","_element_custom_width":{"unit":"%","size":90,"sizes":[]},"_flex_align_self":"center"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":false,"elType":"container"},{"id":"2b43962c","settings":{"flex_direction":"column","boxed_width":{"unit":"px","size":980,"sizes":[]},"padding":{"unit":"px","top":"50","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[{"id":"4bb00690","settings":{"content_width":"full"},"elements":[{"id":"317cfa2b","settings":{"title":"Frequently Asked Questions About Water Quality & Purification in Middle Tennessee \n","align":"center","__globals__":{"title_color":"globals\/colors?id=secondary"}},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"183f1d7c","settings":{"items":[{"item_title":"What are the signs that I have hard water?","_id":"6fbcd1d"},{"item_title":"Is 80 PSI too high for my home's water pressure? ","_id":"95c3315"},{"item_title":"How often should I have my water quality tested? ","_id":"7b4c559"},{"item_title":"What is the difference between a water softener and a purification system? ","_id":"ff2785c"}],"accordion_item_title_position_horizontal":"stretch","accordion_item_title_icon_position":"end","accordion_item_title_icon":{"value":"fas fa-chevron-down","library":"fa-solid"},"accordion_item_title_icon_active":{"value":"fas fa-chevron-up","library":"fa-solid"},"faq_schema":"yes","n_accordion_animation_duration":{"unit":"ms","size":250,"sizes":[]},"__globals__":{"t