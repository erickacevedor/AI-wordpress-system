"flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0}},"elements":[{"id":"789a0afd","settings":{"title":"Expert Plumbing Maintenance & Safety Inspections in Middle Tennessee\n","header_size":"h1","__globals__":{"title_color":"globals\/colors?id=a23a917"},"_margin":{"unit":"px","top":"0","right":"0","bottom":"30","left":"0","isLinked":false},"_element_width":"initial"},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"70bca044","settings":{"editor":"<p><b>A plumbing emergency is the last thing your family needs.<\/b><span style=\"font-weight: 400;\"> As a family-owned team, we believe the best repair is the one you never have to make. Our proactive maintenance catches small leaks and high-pressure issues before they become expensive disasters, keeping your water running smoothly and your home protected. <\/span><\/p>","__globals__":{"typography_typography":"globals\/typography?id=accent","text_color":"globals\/colors?id=a23a917"}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"},{"id":"7686419f","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"flex_direction":"row","margin":{"unit":"px","top":"20","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[{"id":"50523536","settings":{"text":"Call Now","link":{"url":"https:\/\/petittheatingandcooling.com\/expert-hvac-services-in-sumner-county-schedule-today\/","is_external":"","nofollow":"","custom_attributes":""},"selected_icon":{"value":"fas fa-phone-alt","library":"fa-solid"},"typography_typography":"custom","typography_font_family":"Montserrat","typography_font_size":{"unit":"em","size":1.2,"sizes":[]},"typography_font_size_tablet":{"unit":"em","size":"","sizes":[]},"typography_font_size_mobile":{"unit":"em","size":"","sizes":[]},"__globals__":{"hover_color":"globals\/colors?id=a23a917","background_color":"globals\/colors?id=accent","background_color_b":"global