nner":true,"elType":"container"}],"isInner":false,"elType":"container"},{"id":"911eb28","settings":{"flex_direction":"column","background_background":"classic","background_image":{"url":"","id":"","size":"","alt":"","source":"library"},"background_position":"center center","background_repeat":"no-repeat","background_size":"cover","background_overlay_background":"classic","background_overlay_color_b":"#2B2E81","background_overlay_gradient_angle":{"unit":"deg","size":150,"sizes":[]},"background_overlay_opacity":{"unit":"px","size":1,"sizes":[]},"padding":{"unit":"px","top":"50","right":"0","bottom":"50","left":"0","isLinked":false},"_title":"Member Benefits","__globals__":{"background_overlay_color":"","background_overlay_color_b":"globals\/colors?id=secondary","background_color":"globals\/colors?id=bd6963d"},"flex_gap":{"column":"10","row":"10","isLinked":true,"unit":"px","size":10},"background_overlay_image":{"url":"https:\/\/petittheatingandcooling.com\/wp-content\/uploads\/2026\/01\/Petitt_WebSectionDividers-02.png","id":716,"size":"","alt":"","source":"library"},"background_overlay_position":"initial","background_overlay_ypos":{"unit":"px","size":430,"sizes":[]},"background_overlay_repeat":"no-repeat","background_overlay_size":"initial"},"elements":[{"id":"54851eb9","settings":{"content_width":"full"},"elements":[{"id":"7f0225d7","settings":{"title":"Maintenance Plans That Pay for Themselves\n","__globals__":{"title_color":"globals\/colors?id=a23a917"},"align":"center"},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"}],"isInner":true,"elType":"container"},{"id":"56d43539","settings":{"content_width":"full","flex_direction":"column","flex_align_items":"center","flex_justify_content":"center"},"elements":[{"id":"69fa652c","settings":{"editor":"<p><span style=\"font-weight: 400;\">A one-time professional inspection in Middle Tennessee typically ranges from <\/span><b>$150 to $300<\/b><span style=\"font-weight: 400;\">. However, most of our neighbors choose our maintenance plans to lock in year-round protection, safety, and long-term savings.<\/span><\/p><p><b>Why join the Petitt family?<\/b><span style=\"font-weight: 400;\">\u00a0<\/span><\/p><p><span style=\"font-weight: 400;\">Our members don't just get a quick check-up; they get these exclusive advantages:<\/span><\/p>","__globals__":{"text_color":"globals\/colors?id=a23a917"}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"},{"id":"548cdd73","settings":{"flex_direction":"row","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"content_width":"full"},"elements":[{"id":"1b7670f7","settings":{"editor":"<p><b>1. Lower Water Bills:<\/b><span style=\"font-weight: 400;\"> By catching \"silent leaks\" in toilets and faucets, we stop the water waste that can quietly add hundreds of dollars to your yearly costs.<\/span><\/p><p><b>2. Longer Appliance Life:<\/b><span style=\"font-weight: 400;\"> Regular water heater flushes and pressure checks prevent the \"mineral mud\" and high stress that cause your expensive appliances to wear out early.<\/span><\/p><p><b>3. Priority Emergency Service:<\/b><span style=\"font-weight: 400;\"> When a pipe bursts or a water heater fails, our members move to the top of our schedule and receive the fastest possible response.<\/span><\/p>","__globals__":{"text_color":"globals\/colors?id=a23a917"}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"},{"id":"276481a6","settings":{"editor":"<p><b>4. Exclusive Repair Discounts:<\/b><span style=\"font-weight: 400;\"> If a repair is ever needed, our plan members enjoy significant discounts on parts and labor for all plumbing fixes.<\/span><\/p><p><b>5. Warranty Protection:<\/b><span style=\"font-weight: 400;\"> Many water heater manufacturers require annual professional maintenance to keep your warranty valid. We provide the documentation you need to stay covered.<\/span><\/p>","__globals__":{"text_color":"globals\/colors?id=a23a917"}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"container"},{"id":"5f98467","settings":{"content_width":"full"},"elements":[{"id":"42698aaf","settings":{"text":"Explore our maintenance payment plans","selected_icon":{"value":"fas fa-chevron-circle-right","library":"fa-solid"},"icon_align":"row-reverse","align":"center","typography_typography":"custom","typography_font_size":{"unit":"em","size":1.2,"sizes":[]},"typography_font_size_tablet":{"unit":"em","size":"","sizes":[]},"typography_font_size_mobile":{"unit":"em","size":"","sizes":[]},"background_color":"#D90000","hover_color":"#FFFFFF","button_background_hover_color":"#AF0000","__globals__":{"hover_color":"globals\/colors?id=a23a917","button_background_hover_color":""},"link":{"url":"https:\/\/petittheatingandcooling.com\/maintenance-plans\/","is_external":"","nofollow":"","custom_attributes":""},"text_padding":{"unit":"px","top":"15","right":"25","bottom":"15","left":"25","isLinked":false}},"elements":[],"isInner":false,"widgetType":"button","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":false,"elType":"container"},{"id":"6f6db5e9","settings":{"flex_direction":"column","boxed_width":{"unit":"px","size":980,"sizes":[]},"padding":{"unit":"px","top":"50","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[{"id":"44c4cea0","settings":{"content_width":"full"},"elements":[{"id":"607e3e4d","settings":{"title":"Frequently Asked Questions About Plumbing Maintenance","align":"center","__globals__":{"title_color":"globals\/colors?id=secondary"}},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"7727f8f2","settings":{"items":[{"item_title":"How can a plumbing inspection prevent my home from flooding? ","_id":"6fbcd1d"},{"item_title":"Why should I flush my water heater every year? ","_id":"68471dc"},{"item_title":"What is a \"Silent Leak\" and how do you find it? ","_id":"6045584"},{"item_title":"Does plumbing maintenance include my outdoor faucets? ","_id":"f186c9d"},{"item_title":"Will plumbing maintenance help my appliances last longer? ","_id":"afde057"}],"accordion_item_title_position_horizontal":"stretch","accordion_item_title_icon_position":"end","accordion_item_title_icon":{"value":"fas fa-chevron-down","library":"fa-solid"},"accordion_item_title_icon_active":{"value":"fas fa-chevron-up","library":"fa-solid"},"faq_schema":"yes","n_accordion_animation_duration":{"unit":"ms","size":250,"sizes":[]},"__globals__":{"title_typography_typography":"globals\/typography?id=accent","active_title_color":"globals\/colors?id=text"},"title_typography_typography":"custom","title_typography_font_family":"Montserrat","title_typography_font_weight":"bold","title_typography_letter_spacing":{"unit":"em","size":-0.02,"sizes":[]}},"elements":[{"id":"2be3d34a","settings":{"_title":"item #1","content_width":"full"},"elements":[{"id":"6f8b74da","settings":{"editor":"<p><span style=\"font-weight: 400;\">A plumbing inspection prevents flooding by catching high water pressure and worn-out valves before they break. By testing how hard water is pushing against your pipes and making sure your emergency shut-off handles actually work, a technician can spot the warning signs of a burst pipe before it causes major water damage.<\/span><\/p>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"7abd0e36","settings":{"_title":"item #1","content_width":"full"},"elements":[{"id":"5b673f00","settings":{"editor":"<p><span style=\"font-weight: 400;\">You should flush your water heater once a year to remove the \"mineral mud\" that builds up in Middle Tennessee tanks. This thick layer of sediment sits at the bottom, forcing your heater to work much harder and stay on longer. Over time, this raises your energy bills and causes the bottom of the tank to rust out and leak.<\/span><\/p>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"7dd0187f","settings":{"_title":"item #1","content_width":"full"},"elements":[{"id":"66b1888","settings":{"editor":"<p><span style=\"font-weight: 400;\">A silent leak is a hidden water loss that you can\u2019t see or hear, like a slow leak inside a toilet tank or an underground pipe. These leaks can waste over 200 gallons of water a day. Experts find them using simple color tests in your tanks and by checking your water meter to make sure no water is moving when all your faucets are off.<\/span><\/p>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"55010a4c","settings":{"_title":"item #1","content_width":"full"},"elements":[{"id":"1776e66c","settings":{"editor":"<p><span style=\"font-weight: 400;\">Yes, a professional maintenance check includes testing your outdoor spigots for leaks or cracks. This is especially important in Middle Tennessee after a cold winter. We make sure the pipes leading outside didn't freeze or split, so you don't end up with a flooded basement the first time you turn on the hose in the spring.<\/span><\/p>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"a4531fe","settings":{"_title":"item #1","content_width":"full"},"elements":[{"id":"61d4a20e","settings":{"editor":"<p><span style=\"font-weight: 400;\">Yes, plumbing maintenance helps your dishwasher and washing machine last longer by keeping your water pressure at a safe level. If your water pressure is too high, it hits the delicate parts inside your appliances like a power washer. Keeping that pressure steady prevents those expensive machines from wearing out years before they should.<\/span><\/p>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true}],"isInner":false,"widgetType":"nested-accordion","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":false,"elType":"container"},{"id":"7d0bcb49","settings":{"flex_direction":"column","boxed_width":{"unit":"%","size":"","sizes":[]},"boxed_width_tablet":{"unit":"%","size":"","sizes":[]},"boxed_width_mobile":{"unit":"%","size":"","sizes":[]},"padding":{"unit":"px","top":"50","right":"0","bottom":"50","left":"0","isLinked":false},"_title":"CTA","background_background":"classic","background_overlay_background":"classic","background_overlay_image":{"url":"https:\/\/petittheatingandcooling.com\/wp-content\/uploads\/2026\/01\/Petitt_WebSectionDividers-03.png","id":717,"size":"","alt":"","source":"library"},"background_overlay_position":"center center","background_overlay_repeat":"no-repeat","background_overlay_opacity":{"unit":"px","size":1,"sizes":[]},"__globals__":{"background_color":"globals\/colors?id=a23a917"}},"elements":[{"id":"4b5cd80b","settings":{"content_width":"full"},"elements":[{"id":"61c07c06","settings":{"content_width":"full","min_height":{"unit":"px","size":500,"sizes":[]},"flex_justify_content":"center","background_background":"classic","background_image":{"url":"https:\/\/petittheatingandcooling.com\/wp-content\/uploads\/2026\/02\/09-25-Petitt-Photos-14-of-31.webp","id":4303,"size":"","alt":"","source":"library"},"background_position":"center center","background_repeat":"no-repeat","background_size":"cover","border_radius":{"unit":"px","top":"15","right":"15","bottom":"15","left":"15","isLinked":true},"box_shadow_box_shadow_type":"yes","box_shadow_box_shadow":{"horizontal":0,"vertical":4,"blur":16,"spread":0,"color":"rgba(0, 0, 0, 0.1)"},"padding":{"unit":"px","top":"0","right":"30","bottom":"0","left":"30","isLinked":false}},"elements":[{"id":"4f5b2c54","settings":{"content_width":"full","flex_direction":"column","flex_justify_content":"center","width"