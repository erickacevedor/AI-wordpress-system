iner"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"container"},{"id":"143e1ae","settings":{"flex_direction":"column","background_background":"classic","padding":{"unit":"px","top":"50","right":"0","bottom":"50","left":"0","isLinked":false},"_title":"info","__globals__":{"background_color":"globals\/colors?id=a23a917"},"z_index":1},"elements":[{"id":"630435cb","settings":{"flex_direction":"column","padding":{"unit":"px","top":"00","right":"0","bottom":"0","left":"00","isLinked":false},"content_width":"full"},"elements":[{"id":"21370990","settings":{"flex_direction":"column","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"content_width":"full"},"elements":[{"id":"1bb80b49","settings":{"title":"Why Professional Plumbing Maintenance Matters \n","align":"center","__globals__":{"title_color":"globals\/colors?id=secondary"}},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"container"},{"id":"68abf6b8","settings":{"content_width":"full","flex_direction":"row","flex_align_items":"flex-start","flex_gap":{"column":"50","row":"50","isLinked":true,"unit":"px","size":50}},"elements":[{"id":"3c386ec4","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"2f985c5b","settings":{"editor":"<p><span style=\"font-weight: 400;\">Most homeowners don't think about their pipes until there is a puddle on the floor. However, Middle Tennessee\u2019s unique water chemistry and temperature swings put constant stress on your system. Routine maintenance is the key to extending the life of your appliances and avoiding \"hidden\" water waste.<\/span><\/p><h3><b>5 Signs Your Plumbing Needs a Professional Tune-Up<\/b><\/h3><p><span style=\"font-weight: 400;\">We don't just \"look\" at your system; we calibrate it for peak performance. Our maintenance includes:<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><b>Rising Water Bills:<\/b><span style=\"font-weight: 400;\"> If your bill is creeping up without extra usage, you likely have a \"silent leak\" in a toilet or an underground line.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><b>Clanging or Banging Pipes:<\/b><span style=\"font-weight: 400;\"> Known as \"water hammer,\" these sounds often mean your water pressure is too high, which can cause pipes to burst over time.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><b>Slow Drains Throughout the Home:<\/b><span style=\"font-weight: 400;\"> One slow drain is a clog\u2014multiple slow drains mean your entire system is struggling with buildup.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><b>Rust-Colored Water:<\/b><span style=\"font-weight: 400;\"> This is often a sign of sediment buildup inside your water heater or aging pipes that are starting to corrode.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><b>Low Water Pressure:<\/b><span style=\"font-weight: 400;\"> If your shower feels weak, it could be caused by mineral buildup in your fixtures or a failing pressure regulator.<\/span><\/li><\/ul>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container"},{"id":"3493d390","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"6de6e4d4","settings":{"image":{"url":"https:\/\/petittheatingandcooling.com\/wp-content\/uploads\/2026\/04\/professional-plumbing-maintenance.webp","id":5727,"size":"","alt":"Professional Plumbing Maintenance","source":"library"},"width":{"unit":"%","size":100,"sizes":[]},"image_border_radius":{"unit":"px","top":"12","right":"12","bottom":"12","left":"12","isLinked":true},"image_box_shadow_box_shadow_type":"yes","image_box_shadow_box_shadow":{"horizontal":0,"vertical":10,"blur":10,"spread":0,"color":"rgba(0, 0, 0, 0.15)"}},"elements":[],"isInner":false,"widgetType":"image","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"container"}],"isInner":false,"elType":"container"},{"id":"566af535","settings":{"content_width":"full","margin":{"unit":"px","top":"-50","right":"0","bottom":"-150","left":"0","isLinked":false},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"_title":"Stripe","min_height":{"unit":"px","size":280,"sizes":[]},"background_background":"classic","background_image":{"url":"https:\/\/petittheatingandcooling.com\/wp-content\/uploads\/2026\/01\/Petitt_WebSectionDividers-01.png","id":715,"size":"","alt":"","source":"library"},"background_position":"center center","background_repeat":"no-repeat","background_size":"initial"},"elements":[],"isInner":false,"elType":"container"},{"id":"453875aa","settings":{"flex_direction":"column","padding":{"unit":"px","top":"50","right":"0","bottom":"50","left":"0","isLinked":false},"_title":"PetittPromise-Services"},"elements":[{"id":"a130d0f","settings":{"content_width":"full"},"elements":[{"id":"4a43a8c3","settings":{"title":"Why Your Neighbors Trust Petitt Heating & Cooling","typography_typography":"custom","__globals__":{"title_color":"globals\/colors?id=secondary"},"align":"center"},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"1cadf984","settings":{"editor":"<p>Since 2010, the Petitt family has treated every Middle Tennessee home like our own. We aren't a big national chain. Instead, we are a local team that believes in transparency and doing the job right the first time.<\/p>","__globals__":{"text_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=text"},"paragraph_spacing":{"unit":"px","size":0,"sizes":[]},"align":"center","_element_custom_width":{"unit":"%","size":75,"sizes":[]},"_flex_align_self":"center","_element_width":"initial"},"elements":[],"isInner":false,"widgetType