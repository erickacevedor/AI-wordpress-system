{"content":[{"id":"1c31236","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"6f776d95","settings":{"html":"<link rel=\"preconnect\" href=\"https:\/\/fonts.googleapis.com\">\r\n<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Oswald:wght@400;500;600;700&family=Open+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\r\n\r\n<style>\r\n  :root {\r\n    --blue:    #0032AF;\r\n    --red:     #D90000;\r\n    --sky:     #009DF6;\r\n    --black:   #000000;\r\n    --white:   #FFFFFF;\r\n    --grey:    #EDEDED;\r\n    --heading: 'Oswald', Helvetica, Arial, Lucida, sans-serif;\r\n    --body:    'Open Sans', Arial, sans-serif;\r\n  }\r\n\r\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\r\n\r\n  html { scroll-behavior: smooth; }\r\n\r\n  body {\r\n    font-family: var(--body);\r\n    background: var(--white);\r\n    color: var(--black);\r\n    overflow-x: hidden;\r\n  }\r\n  h1{\r\n      color: white !important;\r\n  }\r\n\r\n  \/* \u2500\u2500\u2500 SCROLL REVEAL \u2500\u2500\u2500 *\/\r\n  .reveal {\r\n    opacity: 0;\r\n    transform: translateY(40px);\r\n    transition: opacity .7s ease, transform .7s ease;\r\n  }\r\n  .reveal.visible {\r\n    opacity: 1;\r\n    transform: none;\r\n  }\r\n  .reveal-left {\r\n    opacity: 0;\r\n    transform: translateX(-50px);\r\n    transition: opacity .7s ease, transform .7s ease;\r\n  }\r\n  .reveal-left.visible { opacity: 1; transform: none; }\r\n  .reveal-right {\r\n    opacity: 0;\r\n    transform: translateX(50px);\r\n    transition: opacity .7s ease, transform .7s ease;\r\n  }\r\n  .reveal-right.visible { opacity: 1; transform: none; }\r\n\r\n  \/* \u2500\u2500\u2500 HERO \u2500\u2500\u2500 *\/\r\n  .hero {\r\n    position: relative;\r\n    min-height: 100vh;\r\n    display: grid;\r\n    grid-template-columns: 1fr 1fr;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .hero-left {\r\n    position: relative;\r\n    background: var(--blue);\r\n    display: flex;\r\n    flex-direction: column;\r\n    justify-content: center;\r\n    padding: 80px 60px 80px 80px;\r\n    z-index: 2;\r\n  }\r\n\r\n  \/* Diagonal cut on the right edge of the blue panel *\/\r\n  .hero-left::after {\r\n    content: '';\r\n    position: absolute;\r\n    right: -60px;\r\n    top: 0;\r\n    width: 120px;\r\n    height: 100%;\r\n    background: var(--blue);\r\n    clip-path: polygon(0 0, 50% 0, 100% 100%, 0 100%);\r\n    z-index: 3;\r\n  }\r\n\r\n  .hero-eyebrow {\r\n    font-family: var(--body);\r\n    font-size: 13px;\r\n    font-weight: 600;\r\n    letter-spacing: 3px;\r\n    text-transform: uppercase;\r\n    color: var(--sky);\r\n    margin-bottom: 20px;\r\n    opacity: 0;\r\n    animation: fadeUp .6s .3s forwards;\r\n  }\r\n\r\n  .hero-badge {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    background: var(--red);\r\n    color: var(--white);\r\n    font-family: var(--heading);\r\n    font-size: 14px;\r\n    font-weight: 600;\r\n    letter-spacing: 2px;\r\n    text-transform: uppercase;\r\n    padding: 8px 18px;\r\n    margin-bottom: 28px;\r\n    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 50%, calc(100% - 12px) 100%, 0 100%);\r\n    opacity: 0;\r\n    animation: fadeUp .6s .4s forwards;\r\n  }\r\n\r\n  .hero-title {\r\n    font-family: var(--heading);\r\n    font-size: clamp(52px, 6vw, 82px);\r\n    font-weight: 700;\r\n    line-height: .95;\r\n    color: var(--white);\r\n    text-transform: uppercase;\r\n    margin-bottom: 12px;\r\n    opacity: 0;\r\n    animation: fadeUp .7s .5s forwards;\r\n  }\r\n\r\n  .hero-title span.accent {\r\n    color: var(--sky);\r\n    display: block;\r\n  }\r\n\r\n  .hero-title span.red {\r\n    color: var(--red);\r\n  }\r\n\r\n  .hero-subtitle {\r\n    font-family: var(--heading);\r\n    font-size: clamp(18px, 2.5vw, 26px);\r\n    font-weight: 400;\r\n    color: rgba(255,255,255,.75);\r\n    text-transform: uppercase;\r\n    letter-spacing: 2px;\r\n    margin-bottom: 36px;\r\n    opacity: 0;\r\n    animation: fadeUp .7s .65s forwards;\r\n  }\r\n\r\n  .hero-cta {\r\n    display: inline-block;\r\n    background: var(--red);\r\n    color: var(--white);\r\n    font-family: var(--heading);\r\n    font-size: 18px;\r\n    font-weight: 600;\r\n    letter-spacing: 2px;\r\n    text-transform: uppercase;\r\n    text-decoration: none;\r\n    padding: 18px 44px;\r\n    position: relative;\r\n    overflow: hidden;\r\n    align-self: flex-start;\r\n    opacity: 0;\r\n    animation: fadeUp .7s .8s forwards;\r\n    transition: background .25s;\r\n  }\r\n  .hero-cta::before {\r\n    content: '';\r\n    position: absolute;\r\n    inset: 0;\r\n    background: rgba(255,255,255,.12);\r\n    transform: translateX(-100%);\r\n    transition: transform .35s ease;\r\n  }\r\n  .hero-cta:hover::before { transform: translateX(0); }\r\n  .hero-cta:hover { background: #b50000; }\r\n\r\n  \/* Animated counter inside the hero *\/\r\n  .hero-numbers {\r\n    display: flex;\r\n    gap: 32px;\r\n    margin-top: 48px;\r\n    opacity: 0;\r\n    animation: fadeUp .7s 1s forwards;\r\n  }\r\n  .hero-stat {\r\n    border-left: 3px solid var(--sky);\r\n    padding-left: 16px;\r\n  }\r\n  .hero-stat-val {\r\n    font-family: var(--heading);\r\n    font-size: 36px;\r\n    font-weight: 700;\r\n    color: var(--white);\r\n    line-height: 1;\r\n  }\r\n  .hero-stat-label {\r\n    font-size: 12px;\r\n    color: rgba(255,255,255,.6);\r\n    text-transform: uppercase;\r\n    letter-spacing: 1.5px;\r\n    margin-top: 4px;\r\n  }\r\n\r\n  \/* Right side \u2013 image collage *\/\r\n  .hero-right {\r\n    position: relative;\r\n    overflow: hidden;\r\n  }\r\n  .hero-right img.main-img {\r\n    width: 100%;\r\n    height: 100%;\r\n    object-fit: cover;\r\n    object-position: center top;\r\n    opacity: 0;\r\n    animation: fadeIn 1s .6s forwards;\r\n    filter: saturate(1.1);\r\n  }\r\n  .hero-right::before {\r\n    content: '';\r\n    position: absolute;\r\n    inset: 0;\r\n    background: linear-gradient(to right, var(--blue) 0%, transparent 30%);\r\n    z-index: 1;\r\n    pointer-events: none;\r\n  }\r\n\r\n  \/* floating tag on hero *\/\r\n  .hero-float-tag {\r\n    position: absolute;\r\n    bottom: 40px;\r\n    right: 40px;\r\n    background: var(--white);\r\n    padding: 20px 28px;\r\n    z-index: 4;\r\n    box-shadow: 0 20px 60px rgba(0,0,0,.25);\r\n    opacity: 0;\r\n    animation: popIn .6s 1.1s forwards;\r\n    border-top: 4px solid var(--red);\r\n  }\r\n  .hero-float-tag .big { font-family: var(--heading); font-size: 40px; font-weight: 700; color: var(--blue); line-height: 1; }\r\n  .hero-float-tag .small { font-size: 12px; color: #666; text-transform: uppercase; letter-spacing: 1.5px; margin-top: 4px; }\r\n\r\n  \/* Diagonal divider *\/\r\n  .divider-diagonal {\r\n    height: 80px;\r\n    background: var(--blue);\r\n    clip-path: polygon(0 0, 100% 0, 100% 0%, 0 100%);\r\n    margin-top: -2px;\r\n  }\r\n\r\n  \/* \u2500\u2500\u2500 HOW IT WORKS STRIP \u2500\u2500\u2500 *\/\r\n  .strip {\r\n    background: var(--blue);\r\n    padding: 28px 80px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    gap: 0;\r\n    overflow: hidden;\r\n  }\r\n  .strip-item {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 16px;\r\n    flex: 1;\r\n    justify-content: center;\r\n  }\r\n  .strip-icon {\r\n    width: 48px;\r\n    height: 48px;\r\n    border-radius: 50%;\r\n    background: rgba(255,255,255,.15);\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    flex-shrink: 0;\r\n  }\r\n  .strip-icon svg { width: 24px; height: 24px; fill: var(--white); }\r\n  .strip-text .t1 { font-family: var(--heading); font-size: 20px; font-weight: 700; color: var(--white); text-transform: uppercase; }\r\n  .strip-text .t2 { font-size: 12px; color: rgba(255,255,255,.65); letter-spacing: 1px; text-transform: uppercase; }\r\n  .strip-sep { width: 1px; height: 40px; background: rgba(255,255,255,.2); margin: 0 20px; flex-shrink: 0; }\r\n\r\n  \/* \u2500\u2500\u2500 SECTION: ABOUT \u2500\u2500\u2500 *\/\r\n  .section-about {\r\n    padding: 100px 80px;\r\n    display: grid;\r\n    grid-template-columns: 1fr 1fr;\r\n    gap: 80px;\r\n    align-items: center;\r\n    background: var(--white);\r\n  }\r\n  .about-img-wrap {\r\n    position: relative;\r\n  }\r\n  .about-img-wrap img {\r\n    width: 100%;\r\n    height: 480px;\r\n    object-fit: cover;\r\n    display: block;\r\n  }\r\n  .about-img-wrap::after {\r\n    content: '';\r\n    position: absolute;\r\n    bottom: -20px;\r\n    right: -20px;\r\n    width: 50%;\r\n    height: 50%;\r\n    border: 4px solid var(--sky);\r\n    z-index: -1;\r\n  }\r\n  .about-img-accent {\r\n    position: absolute;\r\n    top: -20px;\r\n    left: -20px;\r\n    width: 80px;\r\n    height: 80px;\r\n    background: var(--red);\r\n  }\r\n  .about-content .pre-label {\r\n    font-family: var(--body);\r\n    font-size: 12px;\r\n    font-weight: 600;\r\n    letter-spacing: 3px;\r\n    text-transform: uppercase;\r\n    color: var(--red);\r\n    margin-bottom: 16px;\r\n  }\r\n  .about-content h2 {\r\n    font-family: var(--heading);\r\n    font-size: clamp(36px, 4vw, 52px);\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n    line-height: 1;\r\n    color: var(--black);\r\n    margin-bottom: 24px;\r\n  }\r\n  .about-content h2 span { color: var(--blue); }\r\n  .about-content p {\r\n    font-size: 16px;\r\n    line-height: 1.8;\r\n    color: #444;\r\n    margin-bottom: 16px;\r\n  }\r\n\r\n  \/* \u2500\u2500\u2500 BENEFITS \u2500\u2500\u2500 *\/\r\n  .section-benefits {\r\n    background: var(--grey);\r\n    padding: 100px 80px;\r\n  }\r\n  .benefits-header { text-align: center; margin-bottom: 64px; }\r\n  .benefits-header .pre-label {\r\n    font-size: 12px;\r\n    font-weight: 600;\r\n    letter-spacing: 3px;\r\n    text-transform: uppercase;\r\n    color: var(--red);\r\n    margin-bottom: 12px;\r\n  }\r\n  .benefits-header h2 {\r\n    font-family: var(--heading);\r\n    font-size: clamp(36px, 4vw, 56px);\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n    color: var(--black);\r\n  }\r\n  .benefits-header h2 span { color: var(--blue); }\r\n\r\n  .benefits-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(3, 1fr);\r\n    gap: 24px;\r\n  }\r\n  .benefit-card {\r\n    background: var(--white);\r\n    padding: 40px 36px;\r\n    border-top: 4px solid transparent;\r\n    position: relative;\r\n    transition: border-color .3s, transform .3s, box-shadow .3s;\r\n    cursor: default;\r\n  }\r\n  .benefit-card:hover {\r\n    border-color: var(--blue);\r\n    transform: translateY(-8px);\r\n    box-shadow: 0 24px 60px rgba(0,50,175,.12);\r\n  }\r\n  .benefit-card .card-num {\r\n    font-family: var(--heading);\r\n    font-size: 72px;\r\n    font-weight: 700;\r\n    color: var(--grey);\r\n    line-height: 1;\r\n    position: absolute;\r\n    top: 16px;\r\n    right: 24px;\r\n    transition: color .3s;\r\n  }\r\n  .benefit-card:hover .card-num { color: rgba(0,50,175,.08); }\r\n  .benefit-card .card-icon {\r\n    width: 52px;\r\n    height: 52px;\r\n    background: var(--blue);\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    margin-bottom: 24px;\r\n  }\r\n  .benefit-card .card-icon svg { width: 26px; height: 26px; fill: var(--white); }\r\n  .benefit-card h3 {\r\n    font-family: var(--heading);\r\n    font-size: 22px;\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n    color: var(--black);\r\n    margin-bottom: 12px;\r\n  }\r\n  .benefit-card p { font-size: 14px; color: #555; line-height: 1.7; }\r\n\r\n  \/* \u2500\u2500\u2500 FORM SECTION \u2500\u2500\u2500 *\/\r\n  .section-form {\r\n    padding: 100px 80px;\r\n    background: var(--white);\r\n    display: grid;\r\n    grid-template-columns: 1fr 1fr;\r\n    gap: 80px;\r\n    align-items: start;\r\n  }\r\n  .form-left .pre-label {\r\n    font-size: 12px;\r\n    font-weight: 600;\r\n    letter-spacing: 3px;\r\n    text-transform: uppercase;\r\n    color: var(--red);\r\n    margin-bottom: 16px;\r\n  }\r\n  .form-left h2 {\r\n    font-family: var(--heading);\r\n    font-size: clamp(36px, 4vw, 52px);\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n    color: var(--black);\r\n    line-height: 1.1;\r\n    margin-bottom: 24px;\r\n  }\r\n  .form-left h2 span { color: var(--blue); }\r\n  .form-left p { font-size: 16px; color: #444; line-height: 1.8; margin-bottom: 32px; }\r\n\r\n  .checklist { list-style: none; display: flex; flex-direction: column; gap: 14px; }\r\n  .checklist li {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 14px;\r\n    font-size: 15px;\r\n    color: #333;\r\n  }\r\n  .checklist li::before {\r\n    content: '';\r\n    width: 22px;\r\n    height: 22px;\r\n    background: var(--blue);\r\n    flex-shrink: 0;\r\n    clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);\r\n  }\r\n\r\n  .form-right {\r\n    background: var(--blue);\r\n    padding: 48px 44px;\r\n    position: relative;\r\n    overflow: hidden;\r\n  }\r\n  .form-right::before {\r\n    content: '';\r\n    position: absolute;\r\n    top: -60px;\r\n    right: -60px;\r\n    width: 200px;\r\n    height: 200px;\r\n    border-radius: 50%;\r\n    background: rgba(255,255,255,.05);\r\n  }\r\n  .form-right::after {\r\n    content: '';\r\n    position: absolute;\r\n    bottom: -80px;\r\n    left: -40px;\r\n    width: 250px;\r\n    height: 250px;\r\n    border-radius: 50%;\r\n    background: rgba(0,157,246,.1);\r\n  }\r\n  .form-header {\r\n    margin-bottom: 28px;\r\n    position: relative;\r\n    z-index: 2;\r\n  }\r\n  .form-header h3 {\r\n    font-family: var(--heading);\r\n    font-size: 28px;\r\n    font-weight: 700;\r\n    color: var(--white);\r\n    text-transform: uppercase;\r\n  }\r\n  .form-header p { font-size: 14px; color: rgba(255,255,255,.7); margin-top: 6px; }\r\n  .form-iframe-wrap { position: relative; z-index: 2; }\r\n\r\n  \/* \u2500\u2500\u2500 TESTIMONIAL BAND \u2500\u2500\u2500 *\/\r\n  .section-trust {\r\n    background: var(--blue);\r\n    padding: 80px 80px;\r\n  }\r\n  .trust-inner {\r\n    display: grid;\r\n    grid-template-columns: 1fr 2px 1fr 2px 1fr;\r\n    gap: 0;\r\n    align-items: center;\r\n    text-align: center;\r\n  }\r\n  .trust-sep { background: rgba(255,255,255,.2); height: 80px; align-self: center; }\r\n  .trust-item { padding: 0 40px; }\r\n  .trust-val {\r\n    font-family: var(--heading);\r\n    font-size: 54px;\r\n    font-weight: 700;\r\n    color: var(--white);\r\n    line-height: 1;\r\n  }\r\n  .trust-val span { color: var(--sky); }\r\n  .trust-label {\r\n    font-size: 13px;\r\n    color: rgba(255,255,255,.6);\r\n    text-transform: uppercase;\r\n    letter-spacing: 2px;\r\n    margin-top: 8px;\r\n  }\r\n\r\n  \/* \u2500\u2500\u2500 BOTTOM CTA BAND \u2500\u2500\u2500 *\/\r\n  .section-cta-band {\r\n    position: relative;\r\n    overflow: hidden;\r\n    background: var(--grey);\r\n    padding: 80px 80px;\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 60px;\r\n  }\r\n  .cta-band-img {\r\n    width: 380px;\r\n    height: 280px;\r\n    object-fit: cover;\r\n    flex-shrink: 0;\r\n    box-shadow: 20px 20px 0 var(--blue);\r\n  }\r\n  .cta-band-text { flex: 1; }\r\n  .cta-band-text .pre-label { font-size: 12px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--red); margin-bottom: 12px; }\r\n  .cta-band-text h2 { font-family: var(--heading); font-size: clamp(30px, 4vw, 48px); font-weight: 700; text-transform: uppercase; color: var(--black); margin-bottom: 16px; line-height: 1.1; }\r\n  .cta-band-text h2 span { color: var(--blue); }\r\n  .cta-band-text p { font-size: 15px; color: #555; line-height: 1.8; margin-bottom: 28px; }\r\n  .btn-primary {\r\n    display: inline-block;\r\n    background: var(--red);\r\n    color: var(--white);\r\n    font-family: var(--heading);\r\n    font-size: 16px;\r\n    font-weight: 600;\r\n    letter-spacing: 2px;\r\n    text-transform: uppercase;\r\n    text-decoration: none;\r\n    padding: 16px 40px;\r\n    position: relative;\r\n    overflow: hidden;\r\n    transition: background .25s;\r\n  }\r\n  .btn-primary::before {\r\n    content: '';\r\n    position: absolute;\r\n    inset: 0;\r\n    background: rgba(255,255,255,.12);\r\n    transform: translateX(-100%);\r\n    transition: transform .35s;\r\n  }\r\n  .btn-primary:hover::before { transform: translateX(0); }\r\n  .btn-primary:hover { background: #b50000; }\r\n\r\n\r\n  \/* \u2500\u2500\u2500 KEYFRAMES \u2500\u2500\u2500 *\/\r\n  @keyframes fadeUp {\r\n    from { opacity: 0; transform: translateY(30px); }\r\n    to   { opacity: 1; transform: none; }\r\n  }\r\n  @keyframes fadeIn {\r\n    from { opacity: 0; }\r\n    to   { opacity: 1; }\r\n  }\r\n  @keyframes popIn {\r\n    from { opacity: 0; transform: scale(.85); }\r\n    to   { opacity: 1; transform: scale(1); }\r\n  }\r\n\r\n  \/* \u2500\u2500\u2500 PULSE RING on hero badge \u2500\u2500\u2500 *\/\r\n  .pulse-dot {\r\n    width: 10px;\r\n    height: 10px;\r\n    border-radius: 50%;\r\n    background: var(--white);\r\n    position: relative;\r\n    flex-shrink: 0;\r\n  }\r\n  .pulse-dot::after {\r\n    content: '';\r\n    position: absolute;\r\n    inset: -4px;\r\n    border-radius: 50%;\r\n    border: 2px solid var(--white);\r\n    animation: pulse 1.5s infinite;\r\n  }\r\n  @keyframes pulse {\r\n    0%   { transform: scale(1); opacity: .8; }\r\n    100% { transform: scale(2); opacity: 0; }\r\n  }\r\n\r\n  \/* \u2500\u2500\u2500 RESPONSIVE \u2500\u2500\u2500 *\/\r\n  @media (max-width: 1024px) {\r\n    .hero { grid-template-columns: 1fr; min-height: auto; }\r\n    .hero-left { padding: 80px 40px; }\r\n    .hero-left::after { display: none; }\r\n    .hero-right { height: 50vw; }\r\n    .hero-right::before { display: none; }\r\n    .section-about, .section-form { gr