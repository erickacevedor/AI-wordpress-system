   <a href=\"#get-quote\" class=\"btn-primary\">Claim My Offer<\/a>\r\n  <\/div>\r\n<\/section>\r\n\r\n<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 SCROLL REVEAL SCRIPT \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\r\n<script>\r\n  const revealEls = document.querySelectorAll('.reveal, .reveal-left, .reveal-right');\r\n  const io = new IntersectionObserver((entries) => {\r\n    entries.forEach(e => {\r\n      if (e.isIntersecting) {\r\n        e.target.classList.add('visible');\r\n        io.unobserve(e.target);\r\n      }\r\n    });\r\n  }, { threshold: 0.12 });\r\n  revealEls.forEach(el => io.observe(el));\r\n\r\n  \/\/ Stagger children inside benefits grid\r\n  document.querySelectorAll('.benefit-card').forEach((card, i) => {\r\n    card.style.transitionDelay = (i * 0.1) + 's';\r\n  });\r\n<\/script>"},"elements":[],"isInner":false,"widgetType":"html","elType":"widget"}],"isInner":false,"elType":"container"}],"settings":{"template":"default","hide_title":"yes"},"metadata":[]}