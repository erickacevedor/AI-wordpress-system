lse,"widgetType":"text-editor","elType":"widget"},{"id":"5b390189","settings":{"editor":"<p><strong>Here\u2019s what sets us apart:<\/strong><\/p><ul><li><b>Expert Installation:<\/b><span style=\"font-weight: 400;\"> We help you choose between <\/span><b>Vented logs<\/b><span style=\"font-weight: 400;\"> (for that classic, tall-flame look) or <\/span><b>Ventless logs<\/b><span style=\"font-weight: 400;\"> (for maximum heating power) based on your home\u2019s layout.<\/span><\/li><li><b>Safety &amp; Performance Checks:<\/b><span style=\"font-weight: 400;\"> We perform deep cleanings of your burners and ignition parts to prevent dust buildup and ensure the air in your home stays clean.<\/span><\/li><li><b>Outdoor Fireplaces:<\/b><span style=\"font-weight: 400;\"> Extend your patio season with weather-resistant gas logs designed to handle the Tennessee elements.<\/span><\/li><li><b>Reliable Troubleshooting:<\/b><span style=\"font-weight: 400;\"> If your fireplace won't light, smells strange, or makes a whistling sound, we\u2019ll find the fix and restore your \"cozy\" in no time.<\/span><\/li><li style=\"list-style-type: none;\">\u00a0<\/li><\/ul>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container"},{"id":"282411c1","settings":{"content_width":"full","flex_gap":{"column":"","row":"","isLinked":true,"unit":"px","size":null},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"3aec7243","settings":{"image":{"url":"https:\/\/petittheatingandcooling.com\/wp-content\/uploads\/2026\/04\/professional-gas-logs-installation.webp","id":6042,"size":"","alt":"","source":"library"},"height":{"unit":"px","size":550,"sizes":[]},"object-fit":"cover","image_border_radius":{"unit":"px","top":"15","right":"15","bottom":"15","left":"15","isLinked":true},"image_box_shadow_box_shadow_type":"yes","image_box_shadow_box_shadow":{"horizontal":0,"vertical":10,"blur":20,"spread":-10