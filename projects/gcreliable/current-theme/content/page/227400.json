{"content":[{"id":"61a01f97","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"ha_cmc_text":"Happy Addons"},"elements":[{"id":"70ba1c44","settings":{"html":"<style>\r\n\/* ============ BACK TO COOL \u2014 scoped under .btc ============ *\/\r\n.btc *,\r\n.btc *::before,\r\n.btc *::after { box-sizing: border-box; margin: 0; padding: 0; }\r\n\r\n.btc {\r\n  \/* Brand tokens *\/\r\n  --btc-red:      #FF0000;\r\n  --btc-blue:     #0030CD;\r\n  --btc-blue-dk:  #001f85;\r\n  --btc-ink:      #0c1220;\r\n  --btc-slate:    #4a5468;\r\n  --btc-cloud:    #f4f7ff;\r\n  --btc-line:     #dfe6f5;\r\n  --btc-white:    #ffffff;\r\n\r\n  --btc-font: \"brandon-grotesque\", \"Trebuchet MS\", \"Segoe UI\", system-ui, sans-serif;\r\n\r\n  --btc-shadow:   0 18px 50px -20px rgba(0, 48, 205, .35);\r\n  --btc-shadow-sm:0 8px 24px -12px rgba(12, 18, 32, .28);\r\n\r\n  font-family: var(--btc-font);\r\n  color: var(--btc-ink);\r\n  background: var(--btc-white);\r\n  line-height: 1.55 !important;\r\n  -webkit-font-smoothing: antialiased;\r\n  overflow-x: hidden;\r\n}\r\n\r\n.btc img { max-width: 100%; display: block; }\r\n.btc__wrap { width: min(1140px, 92vw); margin-inline: auto; }\r\n\r\n\/* ---------- Buttons ---------- *\/\r\n.btc__btn {\r\n  display: inline-flex; align-items: center; gap: .6rem;\r\n  font-family: var(--btc-font);\r\n  font-weight: 700; font-size: 1.05rem !important; letter-spacing: .01em;\r\n  text-decoration: none; cursor: pointer;\r\n  padding: 1rem 2rem; border: none; border-radius: 999px;\r\n  color: var(--btc-white);\r\n  background: var(--btc-red);\r\n  box-shadow: 0 12px 26px -10px rgba(255, 0, 0, .6);\r\n  transition: transform .25s ease, box-shadow .25s ease, background .25s ease;\r\n}\r\n.btc__btn:hover { transform: translateY(-3px); box-shadow: 0 20px 34px -12px rgba(255, 0, 0, .7); }\r\n.btc__btn:active { transform: translateY(-1px); }\r\n.btc__btn--ghost {\r\n  background: transparent; color: var(--btc-blue);\r\n  box-shadow: inset 0 0 0 2px var(--btc-blue);\r\n}\r\n.btc__btn--ghost:hover { background: var(--btc-blue); color: #fff; box-shadow: inset 0 0 0 2px var(--btc-blue); }\r\n.btc__btn .btc__arrow { transition: transform .25s ease; }\r\n.btc__btn:hover .btc__arrow { transform: translateX(4px); }\r\n\r\n\/* Contrast hardening \u2014 beat host-theme (Avada) link-color rules on <a> CTAs.\r\n   Red-background CTAs must always render white text in every link state. *\/\r\n.btc a.btc__btn,\r\n.btc a.btc__btn:link,\r\n.btc a.btc__btn:visited,\r\n.btc a.btc__btn:hover,\r\n.btc a.btc__btn:focus,\r\n.btc a.btc__btn:active,\r\n.btc button.btc__btn { color: #fff; }\r\n\/* Ghost CTA keeps blue text at rest, flips to white on hover\/focus *\/\r\n.btc a.btc__btn--ghost,\r\n.btc a.btc__btn--ghost:link,\r\n.btc a.btc__btn--ghost:visited { color: var(--btc-blue); }\r\n.btc a.btc__btn--ghost:hover,\r\n.btc a.btc__btn--ghost:focus { color: #fff; }\r\n\r\n\/* ---------- HERO ---------- *\/\r\n.btc__hero {\r\n  position: relative;\r\n  padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(3rem, 6vw, 5rem);\r\n  background:\r\n    radial-gradient(120% 90% at 100% 0%, rgba(0, 48, 205, .10), transparent 60%),\r\n    radial-gradient(120% 90% at 0% 100%, rgba(255, 0, 0, .08), transparent 55%),\r\n    var(--btc-cloud);\r\n  overflow: hidden;\r\n}\r\n\/* ambient drifting cool orbs *\/\r\n.btc__orb { position: absolute; border-radius: 50%; filter: blur(8px); opacity: .5; pointer-events: none; }\r\n.btc__orb--1 { width: 220px; height: 220px; top: -60px; right: 8%;\r\n  background: radial-gradient(circle at 30% 30%, rgba(0,48,205,.55), transparent 70%); animation: btc-float 9s ease-in-out infinite; }\r\n.btc__orb--2 { width: 150px; height: 150px; bottom: -40px; left: 4%;\r\n  background: radial-gradient(circle at 30% 30%, rgba(255,0,0,.35), transparent 70%); animation: btc-float 11s ease-in-out infinite reverse; }\r\n@keyframes btc-float {\r\n  0%,100% { transform: translateY(0) translateX(0); }\r\n  50%     { transform: translateY(-26px) translateX(14px); }\r\n}\r\n\r\n.btc__hero-grid {\r\n  position: relative; z-index: 2;\r\n  display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(2rem, 4vw, 4rem);\r\n  align-items: center;\r\n}\r\n\r\n.btc__eyebrow {\r\n  display: inline-flex; align-items: center; gap: .55rem;\r\n  font-weight: 700; font-size: .82rem !important; letter-spacing: .16em; text-transform: uppercase;\r\n  color: var(--btc-blue);\r\n  background: #fff; padding: .5rem 1rem; border-radius: 999px;\r\n  box-shadow: var(--btc-shadow-sm);\r\n}\r\n.btc__eyebrow .btc__dot { width: 9px; height: 9px; border-radius: 50%; background: var(--btc-red); animation: btc-pulse 1.8s ease-in-out infinite; }\r\n@keyframes btc-pulse { 0%,100%{ transform: scale(1); opacity: 1;} 50%{ transform: scale(1.5); opacity:.55;} }\r\n\r\n.btc__h1 {\r\n  font-weight: 800; line-height: .98 !important; letter-spacing: -.02em;\r\n  font-size: clamp(2.9rem, 7vw, 5.1rem) !important;\r\n  margin: 1.25rem 0 1.1rem;\r\n}\r\n.btc__h1 .btc__cool {\r\n  background: linear-gradient(100deg, var(--btc-red) 0%, #b3006e 42%, var(--btc-blue) 100%);\r\n  background-size: 220% 100%;\r\n  -webkit-background-clip: text; background-clip: text; color: transparent;\r\n  animation: btc-sweep 6s ease-in-out infinite;\r\n}\r\n@keyframes btc-sweep { 0%,100%{ background-position: 0% 50%; } 50%{ background-position: 100% 50%; } }\r\n\r\n.btc__lead {\r\n  font-size: clamp(1.05rem, 1.9vw, 1.25rem) !important; color: var(--btc-slate);\r\n  max-width: 34ch; margin-bottom: 1.9rem;\r\n}\r\n.btc__cta-row { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }\r\n\r\n.btc__phone {\r\n  display: inline-flex; align-items: center; gap: .5rem;\r\n  font-weight: 700; color: var(--btc-ink); text-decoration: none; font-size: 1.05rem !important;\r\n}\r\n.btc__phone span { color: var(--btc-slate); font-weight: 600; font-size: .9rem !important; }\r\n.btc__phone:hover { color: var(--btc-blue); }\r\n\r\n\/* hero visual *\/\r\n.btc__hero-media { position: relative; }\r\n.btc__hero-img {\r\n  width: 100%; aspect-ratio: 4\/5; object-fit: cover;\r\n  border-radius: 26px; box-shadow: var(--btc-shadow);\r\n}\r\n.btc__badge {\r\n  position: absolute; left: -18px; bottom: 30px;\r\n  background: var(--btc-white); border-radius: 18px; padding: 1rem 1.25rem;\r\n  box-shadow: var(--btc-shadow); display: flex; align-items: center; gap: .85rem;\r\n  animation: btc-bob 4s ease-in-out infinite;\r\n}\r\n@keyframes btc-bob { 0%,100%{ transform: translateY(0);} 50%{ transform: translateY(-10px);} }\r\n.btc__badge-icon {\r\n  width: 44px; height: 44px; border-radius: 12px; flex: none;\r\n  display: grid; place-items: center; color: #fff; font-weight: 800; font-size: 1.3rem !important;\r\n  background: linear-gradient(135deg, var(--btc-blue), var(--btc-red));\r\n}\r\n.btc__badge b { display: block; font-size: 1rem !important; line-height: 1.15 !important; }\r\n.btc__badge small { color: var(--btc-slate); font-size: .82rem !important; }\r\n\r\n\/* ---------- SECTION SHELL ---------- *\/\r\n.btc__section { padding: clamp(3.5rem, 7vw, 5.5rem) 0; }\r\n.btc__section-head { max-width: 46ch; margin-bottom: 2.75rem; }\r\n.btc__kicker {\r\n  font-weight: 700; font-size: .82rem !important; letter-spacing: .16em; text-transform: uppercase;\r\n  color: var(--btc-red); margin-bottom: .7rem;\r\n}\r\n.btc__h2 {\r\n  font-weight: 800; letter-spacing: -.015em; line-height: 1.05 !important;\r\n  font-size: clamp(1.9rem, 4vw, 2.9rem) !important;\r\n}\r\n.btc__sub { color: var(--btc-slate); font-size: 1.08rem !important; margin-top: .9rem; }\r\n\r\n\/* ---------- VALUE CARDS ---------- *\/\r\n.btc__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }\r\n.btc__card {\r\n  background: var(--btc-white); border: 1px solid var(--btc-line);\r\n  border-radius: 20px; padding: 2rem 1.75rem;\r\n  transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;\r\n}\r\n.btc__card:hover { transform: translateY(-6px); box-shadow: var(--btc-shadow); border-color: transparent; }\r\n.btc__card-num {\r\n  font-weight: 800; font-size: 1.05rem !important; color: #fff;\r\n  width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center;\r\n  background: linear-gradient(135deg, var(--btc-blue), var(--btc-blue-dk));\r\n  margin-bottom: 1.15rem;\r\n}\r\n.btc__card:nth-child(2) .btc__card-num { background: linear-gradient(135deg, #a3005c, var(--btc-red)); }\r\n.btc__card:nth-child(3) .btc__card-num { background: linear-gradient(135deg, var(--btc-blue), var(--btc-red)); }\r\n.btc__card h3 { font-size: 1.28rem !important; font-weight: 800; margin-bottom: .5rem; letter-spacing: -.01em; }\r\n.btc__card p { color: var(--btc-slate); font-size: 1rem !important; }\r\n\r\n\/* ---------- SERVICES \/ SPLIT ---------- *\/\r\n.btc__split {\r\n  display: grid; grid-template-columns: .95fr 1.05fr; gap: clamp(2rem, 4vw, 3.5rem);\r\n  align-items: center;\r\n}\r\n.btc__split-media { position: relative; }\r\n.btc__split-img { width: 100%; aspect-ratio: 5\/4; object-fit: cover; border-radius: 24px; box-shadow: var(--btc-shadow); }\r\n.btc__list { list-style: none; margin-top: 1.6rem; display: grid; gap: 1rem; }\r\n.btc__list li { display: flex; gap: .85rem; align-items: flex-start; font-size: 1.06rem !important; }\r\n.btc__check {\r\n  flex: none; width: 26px; height: 26px; border-radius: 50%;\r\n  background: var(--btc-blue); color: #fff; display: grid; place-items: center;\r\n  font-size: .8rem !important; font-weight: 800; margin-top: .15rem;\r\n}\r\n.btc__list b { font-weight: 700; }\r\n\r\n\/* ---------- GALLERY STRIP ---------- *\/\r\n.btc__gallery {\r\n  display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;\r\n}\r\n.btc__gallery figure { overflow: hidden; border-radius: 18px; box-shadow: var(--btc-shadow-sm); }\r\n.btc__gallery img { width: 100%; aspect-ratio: 4\/3; object-fit: cover; transition: transform .6s ease; }\r\n.btc__gallery figure:hover img { transform: scale(1.07); }\r\n\r\n\/* ---------- FORM ---------- *\/\r\n.btc__form-section {\r\n  background:\r\n    radial-gradient(120% 120% at 0% 0%, rgba(0,48,205,.14), transparent 55%),\r\n    radial-gradient(120% 120% at 100% 100%, rgba(255,0,0,.12), transparent 55%),\r\n    var(--btc-ink);\r\n  color: #fff;\r\n}\r\n.btc__form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }\r\n.btc__form-section .btc__kicker { color: #ff6b6b; }\r\n.btc__form-section .btc__h2 { color: #fff; }\r\n.btc__form-copy p { color: #c3ccdf; font-size: 1.08rem !important; margin-top: 1rem; max-width: 42ch; }\r\n.btc__form-perks { list-style: none; margin-top: 1.6rem; display: grid; gap: .8rem; }\r\n.btc__form-perks li { display: flex; gap: .7rem; align-items: center; color: #e7ecf7; font-weight: 600; }\r\n.btc__form-perks .btc__check { background: var(--btc-red); }\r\n.btc__form-card {\r\n  background: #fff; border-radius: 22px; padding: 1.5rem;\r\n  box-shadow: 0 30px 70px -25px rgba(0,0,0,.6);\r\n}\r\n.btc__form-card h3 { color: var(--btc-ink); font-size: 1.35rem !important; font-weight: 800; margin-bottom: .3rem; }\r\n.btc__form-card .btc__form-note { color: var(--btc-slate); font-size: .92rem !important; margin-bottom: 1rem; }\r\n.btc__iframe-wrap { position: relative; width: 100%; min-height: 294px; }\r\n.btc__iframe-wrap iframe { width: 100%; height: 294px; border: none; border-radius: 8px; }\r\n\r\n\/* ---------- FOOTER ---------- *\/\r\n.btc__footer { background: var(--btc-ink); color: #8b93a7; padding: 2.5rem 0 3rem; }\r\n.btc__footer-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem; align-items: center; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,.08); }\r\n.btc__brandmark { color: #fff; font-weight: 800; font-size: 1.25rem !important; letter-spacing: -.01em; }\r\n.btc__brandmark span { color: var(--btc-red); }\r\n.btc__fineprint { font-size: .82rem !important; line-height: 1.7 !important; margin-top: 1.5rem; max-width: 90ch; }\r\n\r\n\/* ---------- ANIMATION UTILITIES ---------- *\/\r\n.btc__reveal { opacity: 0; transform: translateY(28px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }\r\n.btc__reveal.is-in { opacity: 1; transform: none; }\r\n.btc__reveal[data-delay=\"1\"] { transition-delay: .08s; }\r\n.btc__reveal[data-delay=\"2\"] { transition-delay: .16s; }\r\n.btc__reveal[data-delay=\"3\"] { transition-delay: .24s; }\r\n\r\n\/* hero load sequence *\/\r\n.btc__hero .btc__anim { opacity: 0; transform: translateY(22px); animation: btc-rise .8s cubic-bezier(.2,.7,.2,1) forwards; }\r\n.btc__hero .btc__anim[data-seq=\"1\"] { animation-delay: .1s; }\r\n.btc__hero .btc__anim[data-seq=\"2\"] { animation-delay: .24s; }\r\n.btc__hero .btc__anim[data-seq=\"3\"] { animation-delay: .38s; }\r\n.btc__hero .btc__anim[data-seq=\"4\"] { animation-delay: .52s; }\r\n.btc__hero .btc__hero-media { opacity: 0; transform: translateY(30px) scale(.98); animation: btc-rise-media 1s cubic-bezier(.2,.7,.2,1) .3s forwards; }\r\n@keyframes btc-rise { to { opacity: 1; transform: none; } }\r\n@keyframes btc-rise-media { to { opacity: 1; transform: none; } }\r\n\r\n\/* ---------- RESPONSIVE ---------- *\/\r\n@media (max-width: 900px) {\r\n  .btc__hero-grid { grid-template-columns: 1fr; }\r\n  .btc__hero-media { order: -1; max-width: 460px; }\r\n  .btc__cards { grid-template-columns: 1fr; }\r\n  .btc__split { grid-template-columns: 1fr; }\r\n  .btc__split-media { order: -1; }\r\n  .btc__gallery { grid-template-columns: 1fr 1fr; }\r\n  .btc__form-grid { grid-template-columns: 1fr; }\r\n}\r\n@media (max-width: 520px) {\r\n  .btc__gallery { grid-template-columns: 1fr; }\r\n  .btc__badge { left: 0; }\r\n}\r\n\r\n\/* ---------- REDUCED MOTION ---------- *\/\r\n@media (prefers-reduced-motion: reduce) {\r\n  .btc *, .btc *::before, .btc *::after { animation: none !important; transition: none !important; }\r\n  .btc__reveal { opacity: 1; transform: none; }\r\n  .btc__hero .btc__anim, .btc__hero .btc__hero-media { opacity: 1; transform: none; }\r\n}\r\n<\/style>\r\n<div class=\"btc\">\r\n\r\n  <!-- ============ HERO ============ -->\r\n  <header class=\"btc__hero\">\r\n    <span class=\"btc__orb btc__orb--1\"><\/span>\r\n    <span class=\"btc__orb btc__orb--2\"><\/span>\r\n    <div class=\"btc__wrap\">\r\n      <div class=\"btc__hero-grid\">\r\n        <div class=\"btc__hero-copy\">\r\n          <span class=\"btc__eyebrow btc__anim\" data-seq=\"1\"><span class=\"btc__dot\"><\/span> Back-to-School Season Offer<\/span>\r\n          <h1 class=\"btc__h1 btc__anim\" data-seq=\"2\">Back to <span class=\"btc__cool\">Cool<\/span>.<\/h1>\r\n          <p class=\"btc__lead btc__anim\" data-seq=\"3\">\r\n            Flexible financing on HVAC repairs and replacements \u2014 so you can keep the\r\n            house comfortable through the busy back-to-school stretch without paying it\r\n            all up front.\r\n          <\/p>\r\n          <div class=\"btc__cta-row btc__anim\" data-seq=\"4\">\r\n            <a href=\"#btc-apply\" class=\"btc__btn\">Check my financing options <span class=\"btc__arrow\">&rarr;<\/span><\/a>\r\n            <a href=\"tel:+19143543320\" class=\"btc__phone\">\r\n              &#128222; (914) 354-3320 <span>Call now<\/span>\r\n            <\/a>\r\n          <\/div>\r\n        <\/div>\r\n        <div class=\"btc__hero-media\">\r\n          <img class=\"btc__hero-img\"\r\n               src=\"https:\/\/gcreliable.com\/wp-content\/uploads\/2026\/07\/gc-reliable-technician-2.webp\"\r\n               alt=\"GC Reliable HVAC technician\">\r\n          <div class=\"btc__badge\">\r\n            <span class=\"btc__badge-icon\">$0<\/span>\r\n            <div>\r\n              <b>Financing available<\/b>\r\n              <small>On approved credit<\/small>\r\n            <\/div>\r\n          <\/div>\r\n        <\/div>\r\n      <\/div>\r\n    <\/div>\r\n  <\/header>\r\n\r\n  <!-- ============ VALUE CARDS ============ -->\r\n  <section class=\"btc__section\">\r\n    <div class=\"btc__wrap\">\r\n      <div class=\"btc__section-head btc__reveal\">\r\n        <p class=\"btc__kicker\">Why finance now<\/p>\r\n        <h2 class=\"btc__h2\">Comfort today, paid on your schedule.<\/h2>\r\n        <p class=\"btc__sub\">A breakdown never picks a convenient time. Financing lets you fix or replace what you need now and spread the cost over time.<\/p>\r\n      <\/div>\r\n      <div class=\"btc__cards\">\r\n        <article class=\"btc__card btc__reveal\" data-delay=\"1\">\r\n          <div class=\"btc__card-num\">1<\/div>\r\n          <h3>Spread the cost<\/h3>\r\n          <p>Turn a large repair or replacement into manageable monthly payments instead of one big bill.<\/p>\r\n        <\/article>\r\n        <article class=\"btc__card btc__reveal\" data-delay=\"2\">\r\n          <div class=\"btc__card-num\">2<\/div>\r\n          <h3>Stay comfortable<\/h3>\r\n          <p>Don't wait on the work your home needs. Get the system running right when the season is at its busiest.<\/p>\r\n        <\/article>\r\n        <article class=\"btc__card btc__reveal\" data-delay=\"3\">\r\n          <div class=\"btc__card-num\">3<\/div>\r\n          <h3>Quick to apply<\/h3>\r\n          <p>Share a few details below and our team will walk you through the financing options you may qualify for.<\/p>\r\n        <\/article>\r\n      <\/div>\r\n    <\/div>\r\n  <\/section>\r\n\r\n  <!-- ============ SERVICES SPLIT ============ -->\r\n  <section class=\"btc__section\" style=\"background: var(--btc-cloud);\">\r\n    <div class=\"btc__wrap\">\r\n      <div class=\"btc__split\">\r\n        <div class=\"btc__split-media btc__reveal\">\r\n          <img class=\"btc__split-img\"\r\n               src=\"https:\/\/gcreliable.com\/wp-content\/uploads\/2026\/07\/AC-Repair-e1742298997642.jpg\"\r\n               alt=\"Air conditioning repair in progress\">\r\n        <\/div>\r\n        <div class=\"btc__split-copy btc__reveal\" data-delay=\"1\">\r\n          <p class=\"btc__kicker\">What's covered<\/p>\r\n          <h2 class=\"btc__h2\">Repairs and replacements, financed.<\/h2>\r\n          <p class=\"btc__sub\">Whether it's a fix to get you through the season or a full system upgrade, financing can apply to the work that keeps your home comfortable.<\/p>\r\n          <ul class=\"btc__list\">\r\n            <li><span class=\"btc__check\">&#10003;<\/span><span><b>AC repairs<\/b> &mdash; get your cooling back up and running.<\/span><\/li>\r\n            <li><span class=\"btc__check\">&#10003;<\/span><span><b>System replacements<\/b> &mdash; upgrade an aging or failing unit.<\/span><\/li>\r\n            <li><span class=\"btc__check\">&#10003;<\/span><span><b>Heating &amp; cooling service<\/b> &mdash; keep everything running ahead of the seasons.<\/span><\/li>\r\n          <\/ul>\r\n          <div style=\"margin-top: 2rem;\">\r\n            <a href=\"#btc-apply\" class=\"btc__btn btc__btn--ghost\">See if you qualify <span class=\"btc__arrow\">&rarr;<\/span><\/a>\r\n          <\/div>\r\n        <\/div>\r\n      <\/div>\r\n    <\/div>\r\n  <\/section>\r\n\r\n  <!-- ============ GALLERY ============ -->\r\n  <section class=\"btc__section\">\r\n    <div class=\"btc__wrap\">\r\n      <div class=\"btc__section-head btc__reveal\">\r\n        <p class=\"btc__kicker\">On the job<\/p>\r\n        <h2 class=\"btc__h2\">Reliable comfort, done right.<\/h2>\r\n      <\/div>\r\n      <div class=\"btc__gallery\">\r\n        <figure class=\"btc__reveal\" data-delay=\"1\"><img src=\"https:\/\/gcreliable.com\/wp-content\/uploads\/2026\/07\/gc-reliable-cooling-services.webp\" alt=\"GC Reliable cooling services\"><\/figure>\r\n        <figure class=\"btc__reveal\" data-delay=\"2\"><img src=\"https:\/\/gcreliable.com\/wp-content\/uploads\/2026\/07\/a6d2f77e-df48-46d0-986c-c8ec36361742.webp\" alt=\"GC Reliable HVAC work\"><\/figure>\r\n        <figure class=\"btc__reveal\" data-delay=\"3\"><img src=\"https:\/\/gcreliable.com\/wp-content\/uploads\/2026\/07\/b811f22a-a4e1-4621-86cd-e9744415c6b7.webp\" alt=\"GC Reliable HVAC service\"><\/figure>\r\n      <\/div>\r\n    <\/div>\r\n  <\/section>\r\n\r\n  <!-- ============ FORM ============ -->\r\n  <section class=\"btc__section btc__form-section\" id=\"btc-apply\">\r\n    <div class=\"btc__wrap\">\r\n      <div class=\"btc__form-grid\">\r\n        <div class=\"btc__form-copy btc__reveal\">\r\n          <p class=\"btc__kicker\">Get started<\/p>\r\n          <h2 class=\"btc__h2\">Check your financing options.<\/h2>\r\n          <p>Fill out the form and our team will reach out to walk you through the financing options available for your repair or replacement.<\/p>\r\n          <ul class=\"btc__form-perks\">\r\n            <li><span class=\"btc__check\">&#10003;<\/span> No obligation to move forward<\/li>\r\n            <li><span class=\"btc__check\">&#10003;<\/span> Applies to repairs and replacements<\/li>\r\n            <li><span class=\"btc__check\">&#10003;<\/span> Friendly, local team<\/li>\r\n          <\/ul>\r\n        <\/div>\r\n        <div class=\"btc__form-card btc__reveal\" data-delay=\"1\" id=\"btc-form-anchor\">\r\n          <h3>Request your options<\/h3>\r\n          <p class=\"btc__form-note\">Takes about a minute.<\/p>\r\n          <div class=\"btc__iframe-wrap\">\r\n            <!-- FORM EMBED \u2014 carried over exactly as provided -->\r\n            <iframe\r\n                src=\"https:\/\/api.leadconnectorhq.com\/widget\/form\/cbwNAbdb0Cl64rdNuu35\"\r\n                style=\"width:100%;height:100%;border:none;border-radius:8px\"\r\n                id=\"inline-cbwNAbdb0Cl64rdNuu35\"\r\n                data-layout=\"{'id':'INLINE'}\"\r\n                data-trigger-type=\"alwaysShow\"\r\n                data-trigger-value=\"\"\r\n                data-activation-type=\"alwaysActivated\"\r\n                data-activation-value=\"\"\r\n                data-deactivation-type=\"neverDeactivate\"\r\n                data-deactivation-value=\"\"\r\n                data-form-name=\"Promo Landing\"\r\n                data-height=\"294\"\r\n                data-layout-iframe-id=\"inline-cbwNAbdb0Cl64rdNuu35\"\r\n                data-form-id=\"cbwNAbdb0Cl64rdNuu35\"\r\n                title=\"Promo Landing\">\r\n            <\/iframe>\r\n          <\/div>\r\n        <\/div>\r\n      <\/div>\r\n    <\/div>\r\n  <\/section>\r\n\r\n<\/div>\r\n\r\n<!-- LeadConnector form embed script \u2014 carried over exactly as provided -->\r\n<script src=\"https:\/\/link.msgsndr.com\/js\/form_embed.js\"><\/script>\r\n\r\n<script>\r\n(function () {\r\n  var root = document.querySelector('.btc');\r\n  if (!root) return;\r\n\r\n  \/\/ Scroll reveals\r\n  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\r\n  var reveals = root.querySelectorAll('.btc__reveal');\r\n  if (reduce || !('IntersectionObserver' in window)) {\r\n    reveals.forEach(function (el) { el.classList.add('is-in'); });\r\n  } else {\r\n    var io = new IntersectionObserver(function (entries) {\r\n      entries.forEach(function (e) {\r\n        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }\r\n      });\r\n    }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });\r\n    reveals.forEach(function (el) { io.observe(el); });\r\n  }\r\n})();\r\n<\/script>","ha_cmc_text":"Happy Addons"},"elements":[],"isInner":false,"widgetType":"html","elType":"widget"}],"isInner":false,"elType":"container"}],"settings":{"template":"elementor_header_footer"},"metadata":[]}