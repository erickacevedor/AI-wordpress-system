            {
             "id": "521e82cc",
             "settings": {
              "title": "Simple, Upfront Membership Pricing",
              "header_size": "h2",
              "typography_font_size": {
               "unit": "custom",
               "size": "clamp(1.75rem, 3vw, 2.45rem)",
               "sizes": []
              },
              "typography_font_size_tablet": {
