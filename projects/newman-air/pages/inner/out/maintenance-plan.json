            },
            {
             "id": "521e9623",
             "settings": {
              "editor": "<p>No surprise fees or hidden catches, just honest, reliable protection for your home.</p>"
             },
             "elements": [],
             "isInner": true,
             "widgetType": "text-editor",
             "elType": "widget"
            },
            {
             "id": "521ea97a",
             "settings": {
              "editor": "<div class=\"price-cards\"><div class=\"price-card featured\"><span class=\"tier\">First HVAC System</span><span class=\"amt\">$149<small> / year</small></span><p>Covers 1 full year &amp; 2 complete maintenance visits</p></div><div class=\"price-card\"><span class=\"tier\">Each Additional System</span><span class=\"amt\">$50<small> / year</small></span><p>Full annual coverage for multi-zone homes or extra units</p></div></div><p class=\"fine\">All memberships run for one full year from the date of sign-up and include two complete seasonal visits (one heating tune-up and one cooling tune-up).</p>"
             },
             "elements": [],
             "isInner": true,
             "widgetType": "text-editor",
             "elType": "widget"
            }
           ],
           "isInner": true,
           "elType": "container"
          },
          {
           "id": "521f0a2d",
           "settings": {
