FFFF","title_bottom_space":{"unit":"px","size":0,"sizes":[]},"title_typography_font_size_tablet":{"unit":"px","size":20,"sizes":[]},"description_typography_font_size_tablet":{"unit":"px","size":34,"sizes":[]}},"elements":[],"isInner":false,"widgetType":"image-box","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"container"},{"id":"690ce506","settings":{"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"78f1244"}]},"elements":[{"id":"7303013d","settings":{"image":{"url":"https:\/\/moesalley.com\/wp-content\/uploads\/2024\/04\/ac-repair-img.webp","id":12722,"size":"","alt":"ac repair img","source":"library"},"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"015c6de"}]},"elements":[],"isInner":false,"widgetType":"image","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"container"}],"isInner":false,"elType":"container"},{"id":"418acb7f","settings":{"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"16d2229"}],"padding":{"unit":"px","top":"30","right":"10","bottom":"30","left":"10","isLinked":false}},"elements":[{"id":"6baa37f","settings":{"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"34c0153"}]},"elements":[{"id":"1ca883a2","settings":{"title":"Fast And Reliable AC Repair When You Need It Most","header_size":"h3","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"acd01d6"}],"_animation":"zoomIn"},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"11c63910","settings":{"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"efe0afb"}],"editor":"<p><span style=\"font-weight: 400;\">When your AC goes out, it's an emergency. Our prompt and reliable same-day service ensures you're not left sweltering for long. We offer flexible scheduling and emergency service to accommodate your busy life, and we arrive fully equipped to tackle most AC problems on the spot.<\/span><\/p><ul><li><b>Detailed Diagnosis:<\/b><span style=\"font-weight: 400;\"> Our technicians undergo rigorous training to diagnose problems accurately, pinpointing the root cause of your AC malfunction. No more guessing games \u2013 we identify the issue and recommend the most effective solution.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><b>Upfront Estimates:<\/b><span style=\"font-weight: 400;\"> Before any repairs begin, you'll receive a transparent and detailed estimate that outlines all the recommended repairs and associated costs. No hidden fees, just honest communication to help you make informed decisions.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><b style=\"font-style: inherit;\">Guaranteed Repairs:<\/b><span style=\"font-weight: 400;\"> We fully stand behind the quality of our workmanship. All repairs come with a comprehensive guarantee, so you can rest assured your AC is fixed right the first time.<\/span><\/li><\/ul>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":false,"elType":"container"},{"id":"45fdff7a","settings":{"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"16d2229"}],"padding":{"unit":"px","top":"30","right":"10","bottom":"30","left":"10","isLinked":false}},"elements":[{"id":"75535743","settings":{"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"34c0153"}]},"elements":[{"id":"1244574","settings":{"title":"Expertise In All AC Makes And Models","header_size":"h3","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"acd01d6"}],"_animation":"zoomIn"},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"58e069cc","settings":{"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"efe0afb"}],"editor":"<p><span style=\"font-weight: 400;\">Don't worry if you're unsure about your AC unit's brand or model. Our technicians are extensively trained to work on all AC makes and models. From central AC systems to ductless mini-splits, we have the expertise to diagnose and repair your specific unit.<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><b>Regular Training:<\/b><span style=\"font-weight: 400;\"> We invest heavily in ongoing training for our technicians, ensuring they stay up-to-date on the latest technologies and advancements in AC repair. This translates to efficient repairs and a longer lifespan for your AC system.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><b style=\"font-style: inherit;\">Genuine Parts:<\/b><span style=\"font-weight: 400;\"> We use only genuine manufacturer-approved parts for repairs. This ensures optimal performance, system compatibility, and a longer lifespan for your AC unit.<\/span><\/li><\/ul>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":false,"elType":"container"},{"id":"55132242","settings":{"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"16d2229"}],"padding":{"unit":"px","top":"30","right":"10","bottom":"30","left":"10","isLinked":false}},"elements":[{"id":"d687781","settings":{"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"34c0153"}]},"elements":[{"id":"54f65ba","settings":{"title":"We Don't Just Fix It, We Optimize It","header_size":"h3","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"acd01d6"}],"_animation":"zoomIn"},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"7a46f51c","settings":{"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"efe0afb"}],"editor":"<p><span style=\"font-weight: 400;\">At Magnolia Air, we go beyond simply fixing your AC. Our goal is to optimize your unit's performance and efficiency. During the repair process, our technicians will identify potential areas for improvement and offer recommendations to enhance your AC's functionality.<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><b>Improved Efficiency:<\/b><span style=\"font-weight: 400;\"> We'll check for airflow restrictions, refrigerant levels, and other factors that can impact your AC's efficiency. By addressing these issues, we can help you save money on your energy bills and reduce your carbon footprint.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><b>Prolonged System Lifespan:<\/b><span style=\"font-weight: 400;\"> Proper maintenance and repairs are crucial for extending the life of your AC system. Our recommendations can help you avoid costly premature replacements and ensure your AC keeps you cool for years to come.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><b style=\"font-style: inherit;\">Enhanced Comfort:<\/b><span style=\"font-weight: 400;\"> An optimized AC system means consistent and reliable cooling throughout your home. No more hot and cold spots, just perfect comfort for you and your family.<\/span><\/li><\/ul>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"},{"id":"61b896fe","settings":{"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"29642c5"}]},"elements":[{"id":"46d18e60","settings":{"text":"Request Service","align":"justify","typography_typography":"custom","typography_font_family":"BeVietnamPro-ExtraBold","typography_font_size":{"unit":"px","size":22,"sizes":[]},"typography_font_size_mobile":{"unit":"px","size":18,"sizes":[]},"typography_font_weight":"500","hover_color":"#FFFFFF","hover_animation":"shrink","border_radius":{"unit":"px","top":"50","right":"50","bottom":"50","left":"50","isLinked":true},"text_padding":{"unit":"px","top":"18","right":"18","bottom":"18","left":"18","isLinked":false},"_element_width":"initi