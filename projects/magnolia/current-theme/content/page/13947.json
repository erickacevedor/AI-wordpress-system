unit":"px","size":30,"sizes":[]},"typography_font_weight":"800","typography_text_transform":"capitalize","typography_line_height":{"unit":"em","size":1.1000000000000001,"sizes":[]},"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"279d6a3"}],"_animation":"zoomIn","__globals__":{"title_color":"globals\/colors?id=primary"}},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"77a5c733","settings":{"items":[{"item_title":"How often should I schedule AC maintenance?","_id":"b6ac301"},{"item_title":"Is AC maintenance the same as an AC tune-up?","_id":"bb6781e"},{"item_title":"Can AC maintenance lower my energy bills?","_id":"832a56f"},{"item_title":"Do I need maintenance if my AC seems to be working fine?","_id":"cc0483d"},{"item_title":"What happens if I skip AC maintenance?","_id":"ea62d83"}],"faq_schema":"yes","title_typography_typography":"custom","title_typography_font_family":"Como-ExtraBold","title_typography_font_size":{"unit":"px","size":22,"sizes":[]},"title_typography_font_weight":"600","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"52a7751"}],"__globals__":{"title_typography_typography":"","normal_title_color":"globals\/colors?id=primary"}},"elements":[{"id":"29e12b35","settings":{"_title":"item #1","content_width":"full","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"edb17cd"}]},"elements":[{"id":"6a885ebe","settings":{"editor":"<p>Most air conditioning systems should be professionally maintained at least once a year. In Central Louisiana, where cooling systems often run heavily for long periods, some homes may benefit from additional attention, especially if the system is older, used frequently, or has a history of repairs.<\/p>","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"38e7912"}]},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"5566c946","settings":{"_title":"item #2","content_width":"full","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"e36b835"}]},"elements":[{"id":"6c19daa3","settings":{"editor":"<p>Not exactly. An AC tune-up is typically a seasonal service, while AC maintenance refers to the broader routine care that supports system performance over time. Maintenance may include tune-up work, inspections, filter guidance, efficiency checks, and identifying small concerns before they become larger issues.<\/p>","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"d1717f7"}]},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"52151532","settings":{"_title":"item #3","content_width":"full","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"eb8eb98"}]},"elements":[{"id":"36628384","settings":{"editor":"<p>Yes, AC maintenance can help improve efficiency by supporting proper airflow, clean components, and smoother system operation. While savings vary by system and home, a maintained AC typically does not have to work as hard to provide cooling.<\/p>","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"3168347"}]},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"7e5c7e03","settings":{"_title":"item #3","content_width":"full","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"eb8eb98"}]},"elements":[{"id":"6e583b8e","settings":{"editor":"<p>Yes. Many AC problems develop quietly before obvious symptoms appear. Maintenance helps identify early signs of wear, airflow restrictions, or efficiency loss before they lead to comfort problems or repairs.<\/p>","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"3168347"}]},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"75f8e80f","settings":{"_title":"item #3","content_width":"full","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"eb8eb98"}]},"elements":[{"id":"30a8f70f","settings":{"editor":"<p>Skipping maintenance can increase the risk of higher energy bills, reduced cooling performance, unnecessary wear, and unexpected breakdowns. Over time, neglect may also shorten the life of your air conditioning system.<\/p>","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"3168347"}]},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true}],"isInner":false,"widgetType":"nested-accordion","elType":"widget"},{"id":"157f1ef3","settings":{"layout":"above","bg_image":{"url":"","id":"","size":"","alt":"mini split installation","source":"library"},"title":"Keep Your Cooling System Ready With Magnolia Air","description":"If your AC has not been serviced recently, now is the time to protect your comfort before Louisiana heat puts your system under heavier demand. Regular AC maintenance can help improve efficiency, reduce strain, and lower the risk of preventable repairs.Our team is ready to inspect your system, explain its condition, and help you keep your air conditioner running reliably.\n\nContact Magnolia Air today to schedule your AC maintenance service and keep your cooling system ready for the season ahead.\n","button":"Schedule AC Maintenance","title_color":"#0C4F4D","button_color":"#D4B351","button_typography_typography":"custom","button_typography_font_family":"BeVietnamPro-ExtraBold","button_typography_font_size":{"unit":"px","size":20,"sizes":[]},"button_typography_font_weight":"500","button_background_color":"#0C4F4D","button_border_color":"#0C4F4D","button_hover_text_color":"#0C4F4D","button_hover_background_color":"#D4B351","button_hover_