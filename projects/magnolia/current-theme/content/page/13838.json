: flex;\r\n    flex-direction: column;\r\n    gap: 18px;\r\n    padding: 20px 0;\r\n  }\r\n\r\n  .plan-name {\r\n    font-family: 'Como-ExtraBold', 'Be Vietnam Pro', sans-serif;\r\n    font-weight: 900;\r\n    font-size: 1.3rem;\r\n    color: var(--gold);\r\n    letter-spacing: .02em;\r\n  }\r\n\r\n  .plan-price {\r\n    display: flex;\r\n    align-items: baseline;\r\n    gap: 6px;\r\n  }\r\n\r\n  .plan-price .amount {\r\n    font-family: 'Como-ExtraBold', 'Be Vietnam Pro', sans-serif;\r\n    font-weight: 900;\r\n    font-size: 2.4rem;\r\n    color: var(--white);\r\n    line-height: 1;\r\n  }\r\n\r\n  .plan-price .per {\r\n    color: rgba(255,255,255,.5);\r\n    font-size: .85rem;\r\n  }\r\n\r\n  .plan-price .or {\r\n    color: rgba(255,255,255,.35);\r\n    font-size: .8rem;\r\n    margin: 0 4px;\r\n  }\r\n\r\n  .plan-features {\r\n    list-style: none;\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 9px;\r\n  }\r\n\r\n  .plan-features li {\r\n    display: flex;\r\n    align-items: flex-start;\r\n    gap: 10px;\r\n    font-size: .82rem;\r\n    color: rgba(255,255,255,.7);\r\n    line-height: 1.45;\r\n  }\r\n\r\n  .plan-features li::before {\r\n    content: '\u2713';\r\n    color: var(--gold);\r\n    font-weight: 700;\r\n    flex-shrink: 0;\r\n    margin-top: 1px;\r\n  }\r\n\r\n  .plan-link {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n    margin-top: 4px;\r\n    color: var(--gold);\r\n    font-size: .85rem;\r\n    font-weight: 500;\r\n    text-decoration: none;\r\n    border-bottom: 1px solid rgba(212,179,81,.4);\r\n    width: fit-content;\r\n    padding-bottom: 2px;\r\n    transition: gap .25s ease, border-color .25s ease;\r\n  }\r\n\r\n  .plan-link:hover {\r\n    gap: 11px;\r\n    border-color: var(--gold);\r\n  }\r\n\r\n  \/* \u2500\u2500\u2500 BENEFITS \u2500\u2500\u2500 *\/\r\n  .benefits-section {\r\n    padding: 100px 80px;\r\n    display: grid;\r\n    grid-template-columns: 1fr 1fr 1fr;\r\n    gap: 0;\r\n  }\