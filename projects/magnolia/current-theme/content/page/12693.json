n_color":"#00333F","title_bottom_space":{"unit":"px","size":0,"sizes":[]}},"elements":[],"isInner":false,"widgetType":"image-box","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"container"},{"id":"4e8823d5","settings":{"editor":"<p>We believe AC repair should come with honest communication, skilled workmanship, and practical solutions that help protect your comfort long after the appointment is over.<\/p>","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"ad56153"}]},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"},{"id":"3cfca098","settings":{"title":"Frequently Asked Questions About AC Repair","align":"center","typography_typography":"custom","typography_font_family":"Como-ExtraBold","typography_font_size":{"unit":"px","size":60,"sizes":[]},"typography_font_size_tablet":{"unit":"px","size":40,"sizes":[]},"typography_font_size_mobile":{"unit":"px","size":30,"sizes":[]},"typography_font_weight":"800","typography_text_transform":"capitalize","typography_line_height":{"unit":"em","size":1.1000000000000001,"sizes":[]},"display_condition_list":[{"display_condition_login_status":"subscriber","_id":"279d6a3"}],"_animation":"zoomIn","__globals__":{"title_color":"globals\/colors?id=primary"}},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"30e8da85","settings":{"items":[{"item_title":"How do I know if my AC repair is urgent?","_id":"b6ac301"},{"item_title":"Why is my AC running but not cooling my home?","_id":"bb6781e"},{"item_title":"Can I keep using my AC if something seems wrong?","_id":"832a56f"},{"item_title":"How long does an AC repair appointment usually take?","_id":"cc0483d"},{"item_title":"What can I do before calling for AC repair?","_id":"ea62d83"}],"faq_schema":"yes","title_typography_typography":"custom","title_typography_font_family":"Como-ExtraBold","title_typography_font_size":{"unit":"px","size":22,"sizes":[]},"title_typography_font_weight":"600","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"52a7751"}],"__globals__":{"title_typography_typography":"","normal_title_color":"globals\/colors?id=primary"}},"elements":[{"id":"7106815e","settings":{"_title":"item #1","content_width":"full","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"edb17cd"}]},"elements":[{"id":"498d4897","settings":{"editor":"<p>AC repair is urgent if your system stops cooling completely, trips the breaker repeatedly, gives off a burning smell, leaks near electrical components, or causes your home to become unsafe or uncomfortable in extreme heat. If you are unsure, it is better to schedule service early so a technician can determine whether the issue requires immediate attention.<\/p>","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"38e7912"}]},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"74302f3","settings":{"_title":"item #2","content_width":"full","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"e36b835"}]},"elements":[{"id":"914e31f","settings":{"editor":"<p>An AC that runs without cooling may have restricted airflow, low refrigerant, dirty coils, thermostat issues, or a failing component. In some cases, the system may be working harder than normal but still unable to keep up with Louisiana heat and humidity. A professional diagnosis can identify the source of the problem and prevent unnecessary repairs.<\/p>","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"d1717f7"}]},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"5097856b","settings":{"_title":"item #3","content_width":"full","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"eb8eb98"}]},"elements":[{"id":"795a0ce9","settings":{"editor":"<p>It depends on the issue. If you notice weak airflow, warm air, loud noises, water leaks, or electrical smells, continuing to run the system may make the problem worse. Turning the system off and scheduling AC repair can help prevent additional damage, especially if the unit is overheating or short cycling.<\/p>","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"3168347"}]},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"16f09717","settings":{"_title":"item #3","content_width":"full","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"eb8eb98"}]},"elements":[{"id":"6a0d74d6","settings":{"editor":"<p>Many AC repair appointments can be completed in a single visit, depending on the issue and whether replacement parts are needed. During the appointment, a technician will inspect the system, identify the cause of the problem, explain the repair options, and complete the repair when possible.<\/p>","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"3168347"}]},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"12bfc7c8","settings":{"_title":"item #3","content_width":"full","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"eb8eb98"}]},"elements":[{"id":"203ea845","settings":{"editor":"<p>Before calling for service, you can check the thermostat settings, replace a dirty air filter, make sure the breaker has not tripped, and confirm that vents are open and unobstructed. If the system still does not cool properly, makes unusual noises, leaks water, or keeps shutting off, it is time to call a professional.<\/p>","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"3168347"}]},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true}],"isInner":false,"widgetType":"nested-accordion","elType":"widget"},{"id":"5b13cc97","settings":{"layout":"above","bg_image":{"url":"","id":"","size":"","alt":"mini split installation","source":"library"},"title":"Restore Your Comfort with Magnolia Air","description":"If your AC is blowing warm air, leaking, making loud noises, short cycling, or struggling to keep up, waiting can make the problem worse. A small repair today may help prevent a major breakdown tomorrow.\n\nContact Magnolia Air today to schedule your AC repair and get your cooling system back on track.\n","button":"Schedule a Repair","title_color":"#0C4F4D","button_color":"#D4B351","button_typography_typography":"custom","button_typography_font_family":"BeVietnamPro-ExtraBold","button_typography_font_size":{"unit":"px","size":20,"sizes":[]},"button_typography_font_weight":"500","button_background_color":"#0C4F4D","button_border_color":"#0C4F4D","button_hover_text_color":"#0C4F4D","button_hover_background_color":"#D4B351","button_hover_border_color":"#D4B351","button_border_width":{"unit":"px","size":5,"sizes":[]},"button_border_radius":{"unit":"px","size":40,"sizes":[]},"transformation":"","_flex_align_self":"center","display_condition_list":[{"display_condition_login_status":"subscriber","_id":"b6fe055"}],"__globals__":{"title_color":"globals\/colors?id=primary","button_color":"globals\/colors?id=secondary","button_background_color":"globals\/colors?id=secondary","overlay_color_hover":"","button_hover_text_color":"globals\/colors?id=primary","button_hover_background_color":"globals\/colors?id=primary","button_hover_border_color":"globals\/colors?id=primary","button_text_color":"","button_border_color":"globals\/colors?id=accent","description_color":"globals\/colors?id=text"},"title_typography_typography":"custom","title_typography_font_family":"Como-ExtraBold","title_typography_font_size":{"unit":"px","size":56,"sizes":[]},"title_