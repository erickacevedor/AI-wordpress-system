      {
       "id": "52055d21",
       "settings": {
        "editor": "<div class=\"compare\"><table><thead><tr><th scope=\"col\">Common Indoor Air Symptom</th><th scope=\"col\">Primary Underlying Cause</th><th scope=\"col\">Recommended IAQ Solution</th></tr></thead><tbody><tr><th scope=\"row\">Rapid Dust Buildup on Furniture</th><td data-label=\"Primary Underlying Cause\">Accumulated debris inside supply/return ducts</td><td data-label=\"Recommended IAQ Solution\">Professional Air Duct Cleaning</td></tr><tr><th scope=\"row\">Frequent Allergy/Asthma Flares</th><td data-label=\"Primary Underlying Cause\">Airborne pollen, pet dander, mold spores, dust mites</td><td data-label=\"Recommended IAQ Solution\">Whole-Home Air Purifier / UV System</td></tr><tr><th scope=\"row\">Musty Odors or Muggy Summer Air</th><td data-label=\"Primary Underlying Cause\">High indoor humidity creating mold/bacteria growth</td><td data-label=\"Recommended IAQ Solution\">Whole-Home Dehumidifier Installation</td></tr><tr><th scope=\"row\">Dry Skin, Static Shocks &amp; Bloody Noses</th><td data-label=\"Primary Underlying Cause\">Extremely low humidity during Iowa winter heating</td><td data-label=\"Recommended IAQ Solution\">Whole-Home Humidifier Installation</td></tr><tr><th scope=\"row\">Hot/Cold Spots or Weak Air Vents</th><td data-label=\"Primary Underlying Cause\">Leaky, disconnected, or crushed ductwork</td><td data-label=\"Recommended IAQ Solution\">Duct Repair &amp; Airflow Balancing</td></tr></tbody></table></div>",
