      {
       "id": "51050fc5",
       "settings": {
        "editor": "<div class=\"compare\"><table><thead><tr><th scope=\"col\">Common Heating Warning Sign</th><th scope=\"col\">What It Usually Means</th><th scope=\"col\">Recommended Action</th></tr></thead><tbody><tr><th scope=\"row\">Blowing Cold Air</th><td data-label=\"What It Usually Means\">Flame sensor issue, pilot light failure, or broken igniter</td><td data-label=\"Recommended Action\">Professional diagnostic &amp; sensor repair</td></tr><tr><th scope=\"row\">Squealing, Scraping, or Banging</th><td data-label=\"What It Usually Means\">Worn blower belt, loose part, or failing motor bearings</td><td data-label=\"Recommended Action\">Shut down system &amp; request immediate repair</td></tr><tr><th scope=\"row\">Uneven Heat / Constant Adjustments</th><td data-label=\"What It Usually Means\">Clogged air filter, failing heat exchanger, or bad sensor</td><td data-label=\"Recommended Action\">Airflow check &amp; thermostat calibration</td></tr><tr><th scope=\"row\">Unusually High Gas or Electric Bills</th><td data-label=\"What It Usually Means\">System working overtime due to severe loss of efficiency</td><td data-label=\"Recommended Action\">Comprehensive heater tune-up or system evaluation</td></tr><tr><th scope=\"row\">Frequent On/Off Cycling (Short-Cycling)</th><td data-label=\"What It Usually Means\">Overheating components, airflow restriction, or cracked heat exchanger</td><td data-label=\"Recommended Action\">Emergency safety &amp; limit switch inspection</td></tr></tbody></table></div>",
        "_css_classes": "compare-wrap"
       },
