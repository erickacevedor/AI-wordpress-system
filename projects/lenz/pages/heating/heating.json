          "css_classes": "hub-svc"
         },
         "elements": [
          {
           "id": "510230db",
           "settings": {
            "html": "<span class=\"symptom__icon\"><svg class=\"icon\" aria-hidden=\"true\"><use href=\"#i-wrench\"/></svg></span>"
           },
           "elements": [],
