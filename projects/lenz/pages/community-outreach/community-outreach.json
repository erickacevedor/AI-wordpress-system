          {
           "id": "6702deea",
           "settings": {
            "title": "Operation Lenz a Helping Hand",
            "header_size": "h2",
            "typography_font_size": {
             "unit": "custom",
             "size": "var(--text-xl)",
             "sizes": []
            },
            "typography_font_size_tablet": {
             "unit": "custom",
