  "gradients": {
    "_native_note": "native:true = emittable as a real Elementor gradient background (two stops + type + angle). Keys confirmed against the repo's existing 4.x kits: background_background/background_color/background_color_stop/background_color_b/background_color_b_stop/background_gradient_type/background_gradient_angle.",
    "warm": {
      "type": "linear",
      "angle": 135,
      "from": "#FFC600",
      "from_stop": 0,
      "to": "#F05A28",
      "to_stop": 100,
      "native": true,
      "used_by": [
        ".financing__panel"
      ],
      "from_global": "globals/colors?id=lzgold",
      "to_global": "globals/colors?id=lzorange"
    },
    "temperature": {
      "type": "linear",
      "angle": 135,
      "from": "#F05A28",
      "from_stop": 0,
      "to": "#7B2D8B",
      "to_stop": 100,
      "native": true,
      "used_by": [
        ".lead-card--warm",
        ".plan__badge",
        ".plan--blue .plan__stripe"
      ],
      "note": "The brand's emotional workhorse.",
      "from_global": "globals/colors?id=lzorange",
      "to_global": "globals/colors?id=lzpurple"
    },
    "cool": {
      "type": "linear",
      "angle": 135,
      "from": "#1A3BCC",
      "from_stop": 0,
      "to": "#07113B",
      "to_stop": 100,
      "native": true,
      "used_by": [
        ".lead-card--cool"
      ],
      "from_global": "globals/colors?id=lzblue5",
      "to_global": "globals/colors?id=secondary"
    },
    "air": {
      "type": "linear",
      "angle": 135,
      "from": "#8F34A2",
      "from_stop": 0,
      "to": "#122A91",
      "to_stop": 100,
      "native": true,
      "used_by": [
        ".lead-card--air"
      ],
      "from_global": "globals/colors?id=lzpurple6",
      "to_global": "globals/colors?id=lzblue7"
    },
    "extra": {
      "type": "linear",
      "angle": 135,
      "from": "#122A91",
      "from_stop": 0,
      "to": "#07113B",
      "to_stop": 100,
      "native": true,
      "used_by": [
        ".lead-card--extra"
      ],
      "from_global": "globals/colors?id=lzblue7",
      "to_global": "globals/colors?id=secondary"
    },
    "heading": {
      "type": "linear",
      "angle": 96,
      "from": "#C83D0E",
      "from_stop": 0,
      "to": "#8F34A2",
      "to_stop": 100,
      "native": false,
      "reason": "background-clip:text — no Elementor control exists",
      "used_by": [
        ".gradient-text",
        ".vprop__num",
        ".about__stat b"
      ],
      "note": "Uses the -600 stops deliberately so clipped text still passes AA under 18px."
    },
    "wordmark": {
      "type": "linear",
      "angle": 170,
      "stops": [
        [
          "#FFC600",
          0
        ],
        [
          "#F05A28",
          38
        ],
        [
          "#D62828",
          62
        ],
        [
          "#7B2D8B",
          100
        ]
      ],
      "native": false,
      "reason": "four stops; Elementor supports two",
      "used_by": [],
      "note": "Defined in tokens.css but currently unused in v4 — reserved for the logo SVG when it lands."
    }
  },
  "css_only": [
    {
      "selector": ".gradient-text, .gradient-text-warm, .hero h1 .accent, .vprop__num, .about__stat b",
      "reason": "background-clip:text has no Elementor control",
      "count": 5
    },
    {
      "selector": ".hero::before",
      "reason": "two stacked radial gradients with 120% 90% at 88% 8% sizing"
    },
    {
      "selector": ".lead-card::after",
      "reason": "radial white sheen at 120% 100% at 100% 0%"
    },
    {
      "selector": ".cta-band::before",
      "reason": "three rgba stops; Elementor gradient takes two"
    },
    {
      "selector": ".marquee",
      "reason": "gradient used as mask-image"
    },
    {
      "selector": ".skel",
      "reason": "animated gradient keyframes"
    }
  ],
