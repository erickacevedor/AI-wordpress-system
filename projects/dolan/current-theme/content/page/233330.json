{"content":[{"id":"4d8a280","settings":{"background_background":"classic","__globals__":{"background_color":"globals\/colors?id=408e485","background_overlay_color":"globals\/colors?id=408e485"},"padding":{"unit":"px","top":"100","right":"0","bottom":"100","left":"0","isLinked":false},"background_image":{"url":"https:\/\/dolandesignhvac.com\/wp-content\/uploads\/2026\/06\/hero-neighborhood_25.webp","id":233193,"size":"","alt":"","source":"library"},"background_position":"center center","background_repeat":"no-repeat","background_size":"cover","background_overlay_background":"classic","background_overlay_opacity":{"unit":"px","size":0.80000000000000004,"sizes":[]}},"elements":[{"id":"1dce9cda","settings":{"content_width":"full","flex_direction":"row","flex_align_items":"center"},"elements":[{"id":"7eb903fa","settings":{"content_width":"full"},"elements":[{"id":"7a0d2179","settings":{"title":"Air Conditioner Maintenance & Tune-Ups in Louisburg, NC\n","header_size":"h1","__globals__":{"title_color":"globals\/colors?id=7f92ea2","typography_typography":""},"typography_typography":"custom","typography_font_family":"Ruda","typography_font_size":{"unit":"em","size":3,"sizes":[]},"typography_font_size_tablet":{"unit":"em","size":"","sizes":[]},"typography_font_size_mobile":{"unit":"em","size":"","sizes":[]},"typography_font_weight":"bold","title_color":"#FFFFFF"},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"625a6800","settings":{"title":"Professional Preventative Care to Protect Your Home Comfort\n","header_size":"p","__globals__":{"title_color":"globals\/colors?id=7f92ea2","typography_typography":"globals\/typography?id=b279f6f"}},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"12638ccf","settings":{"editor":"<p><span style=\"font-weight: 400;\">When the North Carolina summer heat hits its peak, your air conditioner works around the clock to keep your home comfortable. A great cooling system isn\u2019t just about turning it on and hoping for the best\u2014it\u2019s about regular, professional care that keeps it running efficiently, lowers your power bills, and catches minor mechanical issues before they turn into expensive mid-summer breakdowns.<\/span><\/p><p><b>Dolan Design HVAC &amp; Plumbing<\/b><span style=\"font-weight: 400;\"> provides dependable, code-compliant air conditioner maintenance and precision tune-ups for residential properties across Louisburg, Raleigh, Wake Forest, Zebulon, Youngsville, and nearby North Carolina communities.<\/span><\/p><p><span style=\"font-weight: 400;\">Our local, family-owned team helps you optimize your cooling system's performance, extend its lifespan, and ensure your home stays crisp and dry during our stickiest months.<\/span><\/p>","__globals__":{"text_color":"globals\/colors?id=7f92ea2"}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"},{"id":"723f79c6","settings":{"text":"Schedule Your AC Tune-Up Online","link":{"url":"#contact","is_external":"","nofollow":"","custom_attributes":""},"border_border":"solid","border_width":{"unit":"px","top":"1","right":"1","bottom":"1","left":"1","isLinked":true},"border_radius":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"__globals__":{"button_text_color":"globals\/colors?id=be5c055","border_color":"globals\/colors?id=be5c055"},"selected_icon":{"value":"far fa-arrow-alt-circle-right","library":"fa-regular"},"icon_align":"row-reverse","align":"left"},"elements":[],"isInner":false,"widgetType":"button","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"container"}],"isInner":false,"elType":"container"},{"id":"7004b62f","settings":{"flex_direction":"column"},"elements":[{"id":"59e1486","settings":{"content_width":"full"},"elements":[{"id":"ab1b7de","settings":{"title":"Long-Term Benefits of Routine AC Maintenance\n","align":"center","__globals__":{"title_color":"globals\/colors?id=text"}},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"266f5fe1","settings":{"editor":"<p><span style=\"font-weight: 400;\">Skipping your annual AC tune-up forces your system to work twice as hard to cool your home, leading to high power bills, structural issues, and unexpected breakdowns. Giving your air conditioner regular maintenance and clean airflow keeps it running smoothly and prevents unnecessary wear and tear on its parts.\u00a0<\/span><\/p><p><span style=\"font-weight: 400;\">Investing in regular preventative care completely changes how your system runs:<\/span><\/p>","align":"center","__globals__":{"typography_typography":"globals\/typography?id=b279f6f"}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container"},{"id":"2735393b","settings":{"content_width":"full"},"elements":[{"id":"1319bf2c","settings":{"content_width":"full","container_type":"grid","grid_align_items":"start","background_background":"classic","background_color":"#EDF4FF","border_radius":{"unit":"px","top":"12","right":"12","bottom":"12","left":"12","isLinked":true},"padding":{"unit":"px","top":"15","right":"15","bottom":"15","left":"15","isLinked":true},"presetTitle":"Grid","presetIcon":"eicon-container-grid","__globals__":{"background_color":""},"grid_columns_grid":{"unit":"fr","size":2,"sizes":[]}},"elements":[{"id":"5b8288c5","settings":{"selected_icon":{"value":"spectrefa- spectre-fa-solid-1","library":"spectre-fontawesome"},"title_text":"Lower Monthly Power Bills","description_text":"A clean, optimized air conditioner uses significantly less electricity to cool your rooms, saving you money on your ongoing utility costs.\n","__globals__":{"primary_color":"globals\/colors?id=accent","title_color":"globals\/colors?id=408e485","hover_title_color":"globals\/colors?id=408e485","description_color":"globals\/colors?id=text"}},"elements":[],"isInner":false,"widgetType":"icon-box","elType":"widget"},{"id":"69aabc78","settings":{"selected_icon":{"value":"spectrefa- spectre-fa-solid-2","library":"spectre-fontawesome"},"title_text":"Fewer Sudden Breakdowns","description_text":"Catching worn-out parts or minor electrical issues during a routine check keeps you from sweating out a weekend system failure.\n","__globals__":{"primary_color":"globals\/colors?id=accent","title_color":"globals\/colors?id=408e485","hover_title_color":"globals\/colors?id=408e485","description_color":"globals\/colors?id=text"}},"elements":[],"isInner":false,"widgetType":"icon-box","elType":"widget"},{"id":"6cf096bb","settings":{"selected_icon":{"value":"spectrefa- spectre-fa-solid-3","library":"spectre-fontawesome"},"title_text":"Extended Equipment Lifespan","description_text":"Regular service takes the strain off your compressor and motors, helping your system last years longer before needing a replacement.\n","__globals__":{"primary_color":"globals\/colors?id=accent","title_color":"globals\/colors?id=408e485","hover_title_color":"globals\/colors?id=408e485","description_color":"globals\/colors?id=text"}},"elements":[],"isInner":false,"widgetType":"icon-box","elType":"widget"},{"id":"3fc2983d","settings":{"selected_icon":{"value":"spectrefa- spectre-fa-solid-4","library":"spectre-fontawesome"},"title_text":"Valid Manufacturer Warranty","description_text":"Most major cooling brands require documented professional annual maintenance to keep your multi-year parts warranty fully valid.\n","__globals__":{"primary_color":"globals\/colors?id=accent","title_color":"globals\/colors?id=408e485","hover_title_color":"globals\/colors?id=408e485","description_color":"globals\/colors?id=text"}},"elements":[],"isInner":false,"widgetType":"icon-box","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"container"}],"isInner":false,"elType":"container"},{"id":"35d0ce16","settings":{"flex_direction":"column"},"elements":[{"id":"5bb31c48","settings":{"content_width":"full"},"elements":[{"id":"3a38511f","settin