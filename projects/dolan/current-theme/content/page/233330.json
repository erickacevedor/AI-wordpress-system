 on all capacitors, and check contactors for pitting.\n","title_typography_typography":"custom","title_typography_font_family":"Ruda","title_typography_font_weight":"bold","_padding":{"unit":"px","top":"20","right":"20","bottom":"20","left":"20","isLinked":true},"_background_background":"classic","_background_color":"#EDF4FF","_border_radius":{"unit":"px","top":"12","right":"12","bottom":"12","left":"12","isLinked":true},"__globals__":{"primary_color":"globals\/colors?id=accent","title_color":"globals\/colors?id=408e485","hover_title_color":"globals\/colors?id=408e485"}},"elements":[],"isInner":false,"widgetType":"icon-box","elType":"widget"},{"id":"3ce1f38e","settings":{"selected_icon":{"value":"fas fa-check-circle","library":"fa-solid"},"title_text":"Performance & Safety Checks","description_text":"We test and confirm amp draws on motors and compressors, check refrigerant levels, inspect for refrigerant leaks, and thoroughly analyze your indoor airflow systems.\n","title_typography_typography":"custom","title_typography_font_family":"Ruda","title_typography_font_weight":"bold","_padding":{"unit":"px","top":"20","right":"20","bottom":"20","left":"20","isLinked":true},"_background_background":"classic","_background_color":"#EDF4FF","_border_radius":{"unit":"px","top":"12","right":"12","bottom":"12","left":"12","isLinked":true},"__globals__":{"primary_color":"globals\/colors?id=accent","title_color":"globals\/colors?id=408e485","hover_title_color":"globals\/colors?id=408e485"}},"elements":[],"isInner":false,"widgetType":"icon-box","elType":"widget"},{"id":"413d9e7c","settings":{"selected_icon":{"value":"fas fa-check-circle","library":"fa-solid"},"title_text":"Heating Component Inspections","description_text":"For multi-season systems, we check gas pressure, test flame sensors and ignitors, inspect heat exchangers, and check amp draws on backup heat strips.\n","title_typography_typography":"custom","title_typography_font_family":"Ruda","title_typography_font_weight":"bold","_padding":{"unit":"px","top":"20","right":"20","bottom":"20","left":"20","isLinked":true},"_background_background":"classic","_background_color":"#EDF4FF","_border_radius":{"unit":"px","top":"12","right":"12","bottom":"12","left":"12","isLinked":true},"__globals__":{"primary_color":"globals\/colors?id=accent","title_color":"globals\/colors?id=408e485","hover_title_color":"globals\/colors?id=408e485"}},"elements":[],"isInner":false,"widgetType":"icon-box","elType":"widget"},{"id":"2de780af","settings":{"selected_icon":{"value":"fas fa-check-circle","library":"fa-solid"},"title_text":"Drain Line Clearance","description_text":"We test your air conditioning drain lines for clogs and completely clear them to prevent hidden water damage or indoor overflow issues.\n","title_typography_typography":"custom","title_typography_font_family":"Ruda","title_typography_font_weight":"bold","_padding":{"unit":"px","top":"20","right":"20","bottom":"20","left":"20","isLinked":true},"_background_background":"classic","_background_color":"#EDF4FF","_border_radius":{"unit":"px","top":"12","right":"12","bottom":"12","left":"12","isLinked":true},"__globals__":{"primary_color":"globals\/colors?id=accent","title_color":"globals\/colors?id=408e485","hover_title_color":"globals\/colors?id=408e485"}},"elements":[],"isInner":false,"widgetType":"icon-box","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":false,"elType":"container"},{"id":"3682b7e9","settings":{"flex_direction":"column","background_background":"classic","background_color":"#EDF4FF","__globals__":{"background_color":""}},"elements":[{"id":"12f7f650","settings":{"content_width":"full","flex_direction":"row","flex_align_items":"center"},"elements":[{"id":"1a3c798e","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"4bd2e45f","settings":{"title":"AC Preventative Maintenance Agreements\n","__globals__":{"title_color":"globa