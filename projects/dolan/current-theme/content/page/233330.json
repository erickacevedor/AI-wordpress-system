Inner":true,"elType":"container","isLocked":true},{"id":"6a4ba466","settings":{"_title":"item #1","content_width":"full"},"elements":[{"id":"7de3c397","settings":{"editor":"<p><span style=\"font-weight: 400;\">The main difference is that an AC tune-up is a <\/span><b>proactive, preventative service<\/b><span style=\"font-weight: 400;\"> designed to clean components and prevent breakdowns, while an <\/span><a href=\"https:\/\/dolandesignhvac.com\/ac-repair\/\"><span style=\"font-weight: 400;\">AC repair<\/span><\/a><span style=\"font-weight: 400;\"> is a <\/span><b>reactive service<\/b><span style=\"font-weight: 400;\"> performed to fix a specific part that has already failed or broken down.\u00a0<\/span><\/p>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"4ecee30c","settings":{"_title":"item #1","content_width":"full"},"elements":[{"id":"27979f2f","settings":{"editor":"<p><b>Yes, routine maintenance directly lowers your monthly electric bills.<\/b><span style=\"font-weight: 400;\"> Cleaning the coils, tightening electrical connections, and clearing airflow restrictions allows your system to cool your home using significantly less electricity, reducing your ongoing utility costs and energy consumption.\u00a0<\/span><\/p>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"7ece3fba","settings":{"_title":"item #1","content_width":"full"},"elements":[{"id":"6a740921","settings":{"editor":"<p><b>Yes, an HVAC maintenance agreement protects your equipment warranty.<\/b><span style=\"font-weight: 400;\"> Most major manufacturers require documented, annual professional service by a licensed technician to keep your parts warranty valid. A preventative agreement ensures you automatically have this proof for future warranty claims.\u00a0<\/span><\/p>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true}],"isInner":false,"widgetType":"nested-accordion","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":false,"elType":"container"},{"id":"4dc16f0d","settings":{"flex_direction":"column","background_background":"classic","background_image":{"url":"https:\/\/dolandesignhvac.com\/wp-content\/uploads\/2026\/06\/large-cta-Group-Photo1-1-scaled-1.webp","id":233139,"size":"","alt":"","source":"library"},"background_position":"center center","background_repeat":"no-repeat","background_size":"cover","background_overlay_background":"classic","background_overlay_opacity":{"unit":"px","size":0.80000000000000004,"sizes":[]},"padding":{"unit":"px","top":"50","right":"0","bottom":"50","left":"0","isLinked":false},"__globals__":{"background_overlay_color":"globals\/colors?id=408e485"}},"elements":[{"id":"40c54635","settings":{"content_width":"full","background_background":"classic","background_image":{"url":"","id":"","size":"","alt":"","source":"library"},"background_position":"center center","background_repeat":"no-repeat","background_size":"cover","__globals__":{"background_color":""}},"elements":[{"id":"ff8a3a0","settings":{"content_width":"full","width":{"unit":"%","size":50,"sizes":[]}},"elements":[{"id":"7e2c46c0","settings":{"title":"Keep Your Cooling System Running Professionally\n","__globals__":{"title_color":"globals\/colors?id=7f92ea2","typography_typography":"globals\/typography?id=7549918"}},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"1be88a08","settings":{"editor":"<p><span style=\"font-weight: 400;\">Don't wait for your air conditioner to stop blowing cold air in the middle of a heatwave. Keep your system running smoothly, efficiently, and reliably all year long with professional local care.<\/span><\/p><p><span style=\"font-weight: 400;\">Call <\/span><b>(919) 896-8630<\/b><span style=\"font-weight: 400;\"> or request your tune-up online today to set up your air conditioner maintenance or enroll in our Preventative Maintenance Agreement in Louisburg, Raleigh, Wake Forest, Zebulon, and Youngsville.<\/span><\/p><p><b>Better Air. Better Life.<\/b><span style=\"font-weight: 400;\"> Dependable cooling care when your property needs it most.<\/span><\/p>","__globals__":{"text_color":"globals\/colors?id=7f92ea2"}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"},{"id":"79bf7db6","settings":{"text":"Schedule Your Preventative Maintenance Visit Online","link":{"url":"#contact","is_external":"","nofollow":"","custom_attributes":""},"border_border":"solid","border_width":{"unit":"px","top":"1","right":"1","bottom":"1","left":"1","isLinked":true},"border_radius":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"__globals__":{"button_text_color":"globals\/colors?id=be5c055","border_color":"globals\/colors?id=be5c055"},"selected_icon":{"value":"far fa-arrow-alt-circle-right","library":"fa-regular"},"icon_align":"row-reverse","align":"left"},"elements":[],"isInner":false,"widgetType":"button","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"container"}],"isInner":false,"elType":"container"}],"settings":{"template":"default","hide_title":"yes","custom_css":"\/* Pages using both Elementor AND Divi *\/\nbody.elementor-page.et_pb_button_helper_class #sidebar {\n  display: none;\n}\n\nbody.elementor-page.et_pb_button_helper_class #left-area {\n  width: 100% !important;\n  float: none !important;\n  padding-right: 0 !important;\n  padding-bottom: 0 !important;\n}\n\nbody.elementor-page.et_pb_button_helper_class #main-content .container {\n  width: 100%;\n  max-width: 100%;\n  padding-top: 0;\n}\n\nbody.elementor-page.et_pb_button_helper_class #main-content .container:before {\n  display: none;\n}"},"metadata":{"et_enqueued_post_fonts":"a:2:{s:6:\"family\";a:2:{s:10:\"et-gf-ruda\";s:32:\"Ruda:regular,500,600,700,800,900\";s:12:\"et-gf