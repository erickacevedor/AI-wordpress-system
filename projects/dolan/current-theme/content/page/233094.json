:"5d7c670c","settings":{"editor":"<p><span style=\"font-weight: 400;\">Our approach is straightforward. We inspect the issue, explain what we find, and help you understand the best path forward.<\/span><\/p>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container"},{"id":"f95c743","settings":{"content_width":"full"},"elements":[{"id":"28a5275b","settings":{"image":{"url":"https:\/\/dolandesignhvac.com\/wp-content\/uploads\/2026\/06\/van.jpg","id":233155,"size":"","alt":"","source":"library"},"image_border_radius":{"unit":"px","top":"10","right":"10","bottom":"10","left":"10","isLinked":true}},"elements":[],"isInner":false,"widgetType":"image","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":true,"elType":"container"}],"isInner":false,"elType":"container"},{"id":"a4f8ac4","settings":{"flex_direction":"column","background_background":"classic","background_color":"#F8F8FB","padding":{"unit":"px","top":"30","right":"0","bottom":"30","left":"0","isLinked":false}},"elements":[{"id":"2b87981b","settings":{"content_width":"full"},"elements":[{"id":"7472e6c3","settings":{"title":"Plumbing FAQs\n","align":"center","__globals__":{"title_color":"globals\/colors?id=text","typography_typography":"globals\/typography?id=7549918"}},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"}],"isInner":true,"elType":"container"},{"id":"2372076e","settings":{"content_width":"full"},"elements":[{"id":"485d212b","settings":{"items":[{"item_title":"Why is my water bill suddenly higher than usual?","_id":"bbc2cdb"},{"item_title":"How do I know if I have a hidden plumbing leak?","_id":"f39d53c"},{"item_title":"When should I replace my water heater?","_id":"0756321"},{"item_title":"Can water filtration help protect my plumbing?","_id":"8a575da"},{"item_title":"Do small leaks really need professional repair?","_id":"e7ee347"}]},"elements":[{"id":"723ab7fc","settings":{"_title":"item #1","content_width":"full"},"elements":[{"id":"4ee0172c","settings":{"editor":"<p><span style=\"font-weight: 400;\">A sudden increase may be caused by higher water use, but it can also point to a hidden leak. Running toilets, dripping faucets, underground water line leaks, irrigation leaks, and crawl space leaks are common causes.<\/span><\/p>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"659ca947","settings":{"_title":"item #1","content_width":"full"},"elements":[{"id":"3bca1b27","settings":{"editor":"<p><span style=\"font-weight: 400;\">Warning signs include musty odors, damp floors, water stains, low water pressure, soft drywall, mold growth, or a water meter that continues moving when all fixtures are off.<\/span><\/p>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"5acf685b","settings":{"_title":"item #1","content_width":"full"},"elements":[{"id":"508f2f4c","settings":{"editor":"<p><span style=\"font-weight: 400;\">Replacement may make sense if your water heater is more than 10 years old, leaking, making unusual noises, producing rusty water, or failing to provide enough hot water.<\/span><\/p>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"c1e449","settings":{"_title":"item #1","content_width":"full"},"elements":[{"id":"dd562a2","settings":{"editor":"<p><span style=\"font-weight: 400;\">Yes. Depending on your water quality, filtration may help reduce sediment, buildup, taste issues, and wear on fixtures or appliances.<\/span><\/p>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true},{"id":"1373bb82","settings":{"_title":"item #1","content_width":"full"},"elements":[{"id":"5a4b99f8","settings":{"editor":"<p><span style=\"font-weight: 400;\">Yes. Even small leaks can waste water, damage materials, and create moisture problems over time. Repairing them early usually costs less than waiting.<\/span><\/p>"},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container","isLocked":true}],"isInner":false,"widgetType":"nested-accordion","elType":"widget"}],"isInner":true,"elType":"container"}],"isInner":false,"elType":"container"},{"id":"60106fa","settings":{"flex_direction":"column","background_background":"classic","background_image":{"url":"https:\/\/dolandesignhvac.com\/wp-content\/uploads\/2026\/06\/large-cta-Group-Photo1-1-scaled-1.webp","id":233139,"size":"","alt":"","source":"library"},"background_position":"center center","background_repeat":"no-repeat","background_size":"cover","background_overlay_background":"classic","background_overlay_opacity":{"unit":"px","size":0.80000000000000004,"sizes":[]},"padding":{"unit":"px","top":"50","right":"0","bottom":"50","left":"0","isLinked":false},"__globals__":{"background_overlay_color":"globals\/colors?id=408e485"}},"elements":[{"id":"71e60e5d","settings":{"content_width":"full","background_background":"classic","background_image":{"url":"","id":"","size":"","alt":"","source":"library"},"background_position":"center center","background_repeat":"no-repeat","background_size":"cover","__globals__":{"background_color":""}},"elements":[{"id":"6c012c8f","settings":{"content_width":"full","width":{"unit":"%","size":50,"sizes":[]}},"elements":[{"id":"6adc6345","settings":{"title":"Let\u2019s Get Your Plumbing Back on Track \n","__globals__":{"title_color":"globals\/colors?id=7f92ea2","typography_typography":"globals\/typography?id=7549918"}},"elements":[],"isInner":false,"widgetType":"heading","elType":"widget"},{"id":"40181cf8","settings":{"editor":"<p><span style=\"font-weight: 400;\">Plumbing problems are easier to manage when they are addressed early. Whether you are dealing with a leak, water heater iss