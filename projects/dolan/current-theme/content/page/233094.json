obals__":{"text_color":"globals\/colors?id=text"}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"}],"isInner":true,"elType":"container"},{"id":"58f42cd4","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"69b720a9","settings":{"selected_icon":{"value":"far fa-check-circle","library":"fa-regular"},"title_text":"Leak Detection & Pipe Repair","description_text":"","position":"inline-start","icon_size":{"unit":"px","size":30,"sizes":[]},"__globals__":{"title_typography_typography":"globals\/typography?id=2113601","title_color":"globals\/colors?id=text","primary_color":"globals\/colors?id=accent"}},"elements":[],"isInner":false,"widgetType":"icon-box","elType":"widget"},{"id":"651557ac","settings":{"editor":"<p><span style=\"font-weight: 400;\">Hidden leaks are one of the most frustrating plumbing problems because they are not always easy to see.<\/span><\/p><p><span style=\"font-weight: 400;\">You may notice:<\/span><\/p>","__globals__":{"text_color":"globals\/colors?id=text"}},"elements":[],"isInner":false,"widgetType":"text-editor","elType":"widget"},{"id":"7affdd26","settings":{"icon_list":[{"text":"A higher water bill","selected_icon":{"value":"fas fa-check-circle","library":"fa-solid"},"_id":"04366aa"},{"text":"Damp flooring","selected_icon":{"value":"fas fa-check-circle","library":"fa-solid"},"_id":"0f73cae"},{"text":"Musty odors","selected_icon":{"value":"fas fa-check-circle","library":"fa-solid"},"_id":"6efd171"},{"text":"Water stains","selected_icon":{"value":"fas fa-check-circle","library":"fa-solid"},"_id":"2232858"},{"text":"Soft drywall","selected_icon":{"value":"fas fa-check-circle","library":"fa-solid"},"_id":"f24b358"},{"text":"Wet areas in the yard","selected_icon":{"value":"fas fa-check-circle","library":"fa-solid"},"_id":"8603f54"},{"text":"Low water pressure","selected_icon":{"value":"fas fa-check-circle","library":"fa-solid"},"_id":"